---
import SiteLayout from '../layouts/SiteLayout.astro';
import UpcomingEvents from '../components/UpcomingEvents';
import AboutStats from '../components/AboutStats';
import PastEvents from '../components/PastEvents';
import Team from '../components/Team';
import Partners from '../components/Partners';
---

<SiteLayout
  title="GDG Sydney | Google Developer Group"
  description="GDG Sydney, Google Developer Group Sydney. Connecting developers, designers, and tech enthusiasts across the city."
  ogDescription="A vibrant hub for tech innovators in Sydney. 2,400+ developers, designers, and tech enthusiasts connecting, learning, and growing together."
  ogImage="/operaHouse.png"
  ogImageAlt="Sydney Opera House illustration"
>

  <!-- ════════════════════════════════ HERO ════════════════════════════════ -->
  <section class="hero" id="home" aria-labelledby="hero-heading">
    <div class="hero-illustration" aria-hidden="true">
      <div class="hero-photos">
        <img src="/hero-crowd.jpg" alt="" class="hero-photo hero-photo-back" />
        <img src="/hero-talk.jpg" alt="" class="hero-photo hero-photo-front" />
      </div>
    </div>

    <div class="container">
      <div class="hero-content">
        <h1 class="hero-heading" id="hero-heading">
          Building Sydney's<br />developer<br />community.
        </h1>
        <p class="hero-body">
          A vibrant hub for tech innovators, exploring the future of Google
          technologies and beyond, together.
        </p>
        <div class="hero-actions">
          <a
            href="https://gdg.community.dev/gdg-sydney/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg"
          >
            Join the community
          </a>
          <a href="/speak" class="hero-speak-link">
            Speak at a meetup →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ UPCOMING EVENTS ══════════════════════════ -->
  <UpcomingEvents client:load />

  <!-- ══════════════════════════ ABOUT + STATS ═════════════════════════════ -->
  <AboutStats client:load />

  <!-- ══════════════════════════ PAST EVENTS ══════════════════════════════ -->
  <PastEvents client:load />

  <!-- ══════════════════════════════ TEAM ═════════════════════════════════ -->
  <Team client:load />

  <!-- ══════════════════════════ COMMUNITY LINKS ═══════════════════════════ -->
  <section class="section-community" id="community" aria-label="Find us online">
    <div class="container">
      <p class="community-label">Find us online</p>
      <nav class="community-links-big">
        <a href="https://www.meetup.com/gdgcloudsydney/" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="meetup">
          <span>Meetup</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="linkedin">
          <span>LinkedIn</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://www.instagram.com/gdgsydney" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="instagram">
          <span>Instagram</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </nav>
    </div>
  </section>

  <!-- ══════════════════════════════ PARTNERS ═════════════════════════════ -->
  <Partners client:load />


  <!-- ════════════════════════════════ CTA ════════════════════════════════ -->
  <section class="section section-cta" aria-label="Join the community">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2 class="cta-heading">Come build with us.</h2>
        <p class="cta-sub">Free events, real talks, and a community of developers across Sydney.</p>
      </div>
      <a href="https://gdg.community.dev/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="btn-cta-join">
        Join the community
      </a>
    </div>
  </section>
</SiteLayout>

<style is:global>
  /* ─── Hero ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-illustration {
    position: absolute;
    right: clamp(24px, 4vw, 72px);
    top: 0;
    bottom: 0;
    height: max-content;
    margin-block: auto;
    width: clamp(340px, 40vw, 560px);
    pointer-events: none;
    z-index: 0;
    animation: fadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.45s;
  }

  .hero-illustration svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-photos {
    position: relative;
  }

  .hero-photo {
    display: block;
    width: 78%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.35);
  }

  .hero-photo-back {
    margin-left: auto;
    rotate: 3deg;
  }

  .hero-photo-front {
    position: relative;
    z-index: 1;
    margin-top: -16%;
    rotate: -4deg;
    border: 4px solid var(--bg);
  }

  .hero .container {
    position: relative;
    z-index: 1;
    padding-top: 8rem;
    padding-bottom: 6rem;
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-heading {
    font-size: clamp(2.75rem, 6.5vw, 5.25rem);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--fg);
    margin-bottom: 1.5rem;
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.1s;
  }

  .hero-body {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.72;
    color: var(--muted);
    margin-bottom: 2.5rem;
    max-width: 480px;
    font-weight: 400;
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.25s;
  }

  .hero .btn {
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.4s;
  }

  /* ─── Keyframes ─────────────────────────────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── Sections ──────────────────────────────────────────────────────── */
  .section {
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--fg);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  /* ─── Community (dark typographic) ──────────────────────────────────── */
  .section-community {
    background: var(--ink);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .community-label {
    font-family: var(--sans);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1.5rem;
  }

  .community-links-big {
    display: flex;
    flex-direction: column;
  }

  .big-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: white;
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    transition: color 0.2s ease;
  }

  .big-link:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.1); }

  .big-link svg {
    flex-shrink: 0;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .big-link:hover svg { opacity: 1; transform: translate(0, 0); }
  .big-link[data-accent="meetup"]:hover   { color: #E51937; }
  .big-link[data-accent="linkedin"]:hover { color: #0A66C2; }
  .big-link[data-accent="instagram"]:hover span {
    background: linear-gradient(90deg, #F58529, #DD2A7B, #8134AF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .big-link[data-accent="instagram"]:hover svg { color: #DD2A7B; }

  /* ─── About ─────────────────────────────────────────────────────────── */
  .about-wrap {
    max-width: 720px;
  }

  .about-body .section-title {
    margin-bottom: 1.5rem;
  }

  .about-text-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .about-text-group p {
    font-size: 1.05rem;
    line-height: 1.78;
    color: var(--text-soft);
    font-weight: 400;
  }

  .about-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.15s ease;
  }

  .about-link:hover { gap: 0.7rem; color: var(--fg); }

  .about-link-primary {
    color: var(--blue-text);
  }

  .about-link-primary:hover { color: var(--blue-text); }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .hero-speak-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .hero-speak-link:hover { color: var(--blue-text); }

  /* ─── CTA ───────────────────────────────────────────────────────────── */
  .section-cta {
    background: var(--blue);
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-heading {
    font-size: clamp(1.5rem, 3.2vw, 2.15rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: white;
    margin-bottom: 0.5rem;
  }

  .cta-sub {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.75);
    max-width: 42ch;
  }

  .btn-cta-join {
    display: inline-flex;
    align-items: center;
    padding: 0.85em 2em;
    border-radius: 100px;
    background: white;
    color: var(--blue);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .btn-cta-join:hover { opacity: 0.9; }

  /* ─── Events ───────────────────────────────────────────────────────── */
  .section-events {
    background: var(--bg);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .event-card {
    background: var(--surface);
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .event-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }

  .event-card-accent {
    height: 4px;
    width: 100%;
  }

  .event-card--blue .event-card-accent { background: var(--blue); }
  .event-card--green .event-card-accent { background: var(--green); }
  .event-card--yellow .event-card-accent { background: var(--yellow); }

  .event-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
  }

  .event-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }

  .event-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .event-tag::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .event-card--blue .event-tag { color: var(--blue-text); }
  .event-card--blue .event-tag::before { background: var(--blue); }
  .event-card--green .event-tag { color: var(--green-text); }
  .event-card--green .event-tag::before { background: var(--green); }
  .event-card--yellow .event-tag { color: var(--yellow-text); }
  .event-card--yellow .event-tag::before { background: var(--yellow); }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .event-date {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }

  .event-time {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.65;
  }

  .event-time::before {
    content: '·';
    margin-right: 0.35rem;
  }

  .event-title {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--fg);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .event-desc {
    font-size: 0.83rem;
    color: var(--muted);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .event-rsvp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.6em 1.4em;
    border-radius: 100px;
    font-size: 0.83rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .event-card--blue .event-rsvp {
    background: var(--blue);
    color: white;
    box-shadow: 0 1px 6px rgba(66, 133, 244, 0.28);
  }
  .event-card--blue .event-rsvp:hover {
    box-shadow: 0 4px 18px rgba(66, 133, 244, 0.42);
    transform: translateY(-1px);
  }

  .event-card--green .event-rsvp {
    background: var(--green);
    color: white;
    box-shadow: 0 1px 6px rgba(52, 168, 83, 0.28);
  }
  .event-card--green .event-rsvp:hover {
    box-shadow: 0 4px 18px rgba(52, 168, 83, 0.42);
    transform: translateY(-1px);
  }

  .event-card--yellow .event-rsvp {
    background: var(--yellow);
    color: white;
    box-shadow: 0 1px 6px rgba(249, 171, 0, 0.28);
  }
  .event-card--yellow .event-rsvp:hover {
    box-shadow: 0 4px 18px rgba(249, 171, 0, 0.42);
    transform: translateY(-1px);
  }

  /* ─── Past Events ──────────────────────────────────────────────────── */
  .section-past {
    border-top: 1px solid var(--border);
  }

  /* ─── Stats ─────────────────────────────────────────────────────────── */
  .section-stats {
    background: var(--ink);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    max-width: 860px;
    margin-inline: auto;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    padding-inline: 1.5rem;
    position: relative;
  }

  .stat + .stat::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 64px;
    background: rgba(255, 255, 255, 0.12);
  }

  .stat-num {
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: white;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
  }

  @media (max-width: 560px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .stat + .stat::before {
      left: 50%;
      top: 0;
      transform: translateX(-50%);
      width: 48px;
      height: 1px;
    }
  }

  .past-list {
    display: flex;
    flex-direction: column;
  }

  .past-item {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
    border-radius: 8px;
    padding-inline: 0.5rem;
    margin-inline: -0.5rem;
  }

  .past-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .past-item:hover {
    background: var(--surface);
  }

  .past-tag {
    font-size: 0.68rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .past-tag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .past-tag--blue  { color: var(--blue-text);  }
  .past-tag--blue::before  { background: var(--blue);  }
  .past-tag--green { color: var(--green-text); }
  .past-tag--green::before { background: var(--green); }
  .past-tag--yellow { color: var(--yellow-text); }
  .past-tag--yellow::before { background: var(--yellow); }

  .past-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.4;
  }

  .past-date {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ─── Partners ─────────────────────────────────────────────────────── */
  .section-partners {
    border-top: 1px solid var(--border);
  }

  .partners-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .partner-card {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Sponsor logos come from Bevy and are designed for white, so their tiles stay light. */
    background: var(--fg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.75rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    height: 120px;
  }

  .partner-card:hover {
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .partner-logo {
    max-height: 96px;
    max-width: 260px;
    width: auto;
    object-fit: contain;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .partner-card:hover .partner-logo {
    opacity: 1;
  }

  /* ─── Team ─────────────────────────────────────────────────────────── */
  .section-team {
    border-top: 1px solid var(--border);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.5rem;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    padding: 1.5rem 1rem;
    border-radius: var(--radius-card);
    transition: background 0.15s ease;
  }

  .team-card:hover {
    background: var(--surface);
  }

  .team-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .team-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .team-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--fg);
    line-height: 1.3;
  }

  .team-role {
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.4;
  }

  /* ─── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: unset;
    }
    .hero .container {
      order: 1;
      padding-bottom: 2rem;
    }
    .hero-illustration {
      order: 2;
      position: static;
      transform: none;
      width: 100%;
      max-width: 420px;
      margin: 1rem auto 0;
      opacity: 1;
    }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .hero-illustration {
      width: clamp(360px, 44vw, 460px);
      right: clamp(-120px, -4vw, 0px);
      opacity: 0.85;
    }
  }
</style>
