---
import SiteLayout from '../layouts/SiteLayout.astro';
import UpcomingEvents from '../components/UpcomingEvents';
import AboutStats from '../components/AboutStats';
import PastEvents from '../components/PastEvents';
import Team from '../components/Team';
import Partners from '../components/Partners';
import NextMeetup from '../components/NextMeetup';
import { Image } from 'astro:assets';
import { speakers } from '../lib/devfest2026';
import devfestPhoto from '../assets/devfest/2026/photos/foyer-crowd.jpg';

const COMMUNITY_URL = 'https://gdg.community.dev/gdg-sydney/';
const PARTNER_MAILTO = 'mailto:hello@gdgsydney.com?subject=Partnering%20with%20GDG%20Sydney';

// Tells search engines and AI agents who GDG Sydney is, since most of this page's detail
// (events, team, partners) loads from Bevy in the browser. See also /llms.txt.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'GDG Sydney',
  alternateName: 'Google Developer Group Sydney',
  url: new URL('/', Astro.site).href,
  logo: new URL('/logo.png', Astro.site).href,
  description:
    'A volunteer-run community of developers and builders in Sydney, running free monthly meetups on AI, Google Cloud and app development since 2013, and the annual DevFest Sydney conference.',
  foundingDate: '2013',
  email: 'hello@gdgsydney.com',
  areaServed: { '@type': 'City', name: 'Sydney' },
  sameAs: [
    'https://gdg.community.dev/gdg-sydney/',
    'https://www.meetup.com/gdgcloudsydney/',
    'https://www.linkedin.com/company/gdg-sydney/',
    'https://www.instagram.com/gdgsydney',
  ],
};
---

<SiteLayout
  title="GDG Sydney | Learn. Build. Connect."
  description="Google Developer Group Sydney runs free monthly meetups for developers, with talks on AI, Google Cloud and app development. Run by local organisers since 2013, and every experience level is welcome."
  ogDescription="Free monthly meetups for Sydney's developers, with talks from Googlers, Google Developer Experts and local engineers. More than 2,400 members since 2013."
  ogImage="/hero-crowd.jpg"
  ogImageAlt="The audience at a GDG Sydney talk"
>
  <!-- Events, team and partners load from Bevy; its images come from Cloudinary. -->
  <link rel="preconnect" href="https://gdg.community.dev" slot="head" />
  <link rel="preconnect" href="https://res.cloudinary.com" slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organizationJsonLd)} />

  <!-- ════════════════════════════════ HERO ════════════════════════════════ -->
  <section class="hero" id="home" aria-labelledby="hero-heading" data-hero>
    <div class="hero-illustration" aria-hidden="true">
      <div class="hero-photos">
        <img src="/hero-crowd.jpg" alt="" width="1500" height="1000" fetchpriority="high" class="hero-photo hero-photo-back" />
        <img src="/hero-talk.jpg" alt="" width="1500" height="1002" fetchpriority="high" class="hero-photo hero-photo-front" />
      </div>
    </div>

    <div class="container">
      <div class="hero-content">
        <h1 class="hero-heading" id="hero-heading">
          Learn. Build.<br />Connect.
        </h1>
        <p class="hero-body">
          Free monthly meetups for Sydney's developers, with talks on AI, Google
          Cloud and app development from Googlers, Google Developer Experts and
          local engineers. Food and drinks are on us, and every level is welcome.
        </p>
        <div class="hero-actions">
          <a
            href="https://gdg.community.dev/gdg-sydney/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg"
          >
            Join the community
          </a>
          <a href="/speak" class="hero-speak-link">
            Speak at a meetup <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>
        <NextMeetup client:load />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ UPCOMING EVENTS ══════════════════════════ -->
  <UpcomingEvents client:load />

  <!-- ══════════════════════════ ABOUT + STATS ═════════════════════════════ -->
  <AboutStats client:load />

  <!-- ═════════════════════════════ DEVFEST ═══════════════════════════════ -->
  <section class="section-devfest" aria-labelledby="devfest-band-heading">
    <Image
      src={devfestPhoto}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      class="devfest-band-photo"
      loading="lazy"
    />
    <div class="devfest-band-scrim" aria-hidden="true"></div>
    <div class="container devfest-band-inner">
      <h2 class="devfest-band-heading" id="devfest-band-heading">DevFest Sydney</h2>
      <p class="devfest-band-body">
        Our annual conference for developers and builders, presented by Google. In 2026,
        280+ people came to hear {speakers.length} speakers, double the crowd of the year before.
      </p>
      <div class="devfest-band-actions">
        <a href="/devfest" class="btn btn-dark btn-lg">About DevFest Sydney</a>
        <a href="/devfest/2026" class="devfest-band-link">See the 2026 lineup <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ PAST EVENTS ══════════════════════════════ -->
  <PastEvents client:load />

  <!-- ══════════════════════════════ TEAM ═════════════════════════════════ -->
  <Team client:load />

  <!-- ═══════════════════════════ GET INVOLVED ════════════════════════════ -->
  <!-- The three ways in, in the same big-row style as Find us online below, on the page
     background so the two bands stay distinct. -->
  <section class="section section-involved" id="get-involved" aria-labelledby="involved-heading">
    <div class="container">
      <h2 class="section-title" id="involved-heading">Get involved</h2>
      <ul class="involved-list" role="list">
        <li>
          <a href={COMMUNITY_URL} target="_blank" rel="noopener noreferrer" class="involved-link" data-accent="blue">
            <span class="involved-link-text">
              <span class="involved-link-title">Come to a meetup</span>
              <span class="involved-link-sub">Free, monthly, with food and drinks. RSVP on our community page.</span>
            </span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
        <li>
          <a href="/speak" class="involved-link" data-accent="green">
            <span class="involved-link-text">
              <span class="involved-link-title">Give a talk</span>
              <span class="involved-link-sub">Propose a talk or a workshop. First-time speakers are welcome.</span>
            </span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
        <li>
          <a href={PARTNER_MAILTO} class="involved-link" data-accent="yellow">
            <span class="involved-link-text">
              <span class="involved-link-title">Partner with us</span>
              <span class="involved-link-sub">Host a meetup or support the community. Email hello@gdgsydney.com.</span>
            </span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════ COMMUNITY LINKS ═══════════════════════════ -->
  <section class="section-community" id="community" aria-label="Find us online">
    <div class="container">
      <p class="community-label">Find us online</p>
      <nav class="community-links-big">
        <a href="https://www.meetup.com/gdgcloudsydney/" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="meetup">
          <span>Meetup</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="linkedin">
          <span>LinkedIn</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://www.instagram.com/gdgsydney" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="instagram">
          <span>Instagram</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </nav>
    </div>
  </section>

  <!-- ══════════════════════════════ PARTNERS ═════════════════════════════ -->
  <Partners client:load />


  <!-- ════════════════════════════════ CTA ════════════════════════════════ -->
  <section class="section section-cta" aria-label="Join the community">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2 class="cta-heading">See you at the next meetup.</h2>
        <p class="cta-sub">Join GDG Sydney on our community page to hear about each meetup as it's announced.</p>
      </div>
      <a href="https://gdg.community.dev/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="btn-cta-join">
        Join the community
      </a>
    </div>
  </section>
</SiteLayout>

<style is:global>
  /* ─── Hero ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    /* The landing page is the one deliberate exception to the shared --hero-h: it gets a
       taller hero on larger screens. Phones use the shared height (see the 640px rule). */
    min-height: min(100svh, 980px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-illustration {
    position: absolute;
    right: clamp(24px, 4vw, 72px);
    top: 0;
    bottom: 0;
    height: max-content;
    margin-block: auto;
    width: clamp(340px, 40vw, 560px);
    pointer-events: none;
    z-index: 0;
    animation: fadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.45s;
  }

  .hero-illustration svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-photos {
    position: relative;
  }

  .hero-photo {
    display: block;
    width: 78%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.35);
  }

  .hero-photo-back {
    margin-left: auto;
    rotate: 3deg;
  }

  .hero-photo-front {
    position: relative;
    z-index: 1;
    margin-top: -16%;
    rotate: -4deg;
    border: 4px solid var(--bg);
  }

  .hero .container {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--header-h) + 1rem);
    padding-bottom: 2rem;
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-heading {
    font-size: clamp(2.75rem, 6.5vw, 5.25rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--fg);
    margin-bottom: 1.5rem;
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.1s;
  }

  .hero-body {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.72;
    color: var(--muted);
    margin-bottom: 2.5rem;
    max-width: 480px;
    font-weight: 400;
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.25s;
  }

  .hero .btn {
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.4s;
  }

  /* ─── Keyframes ─────────────────────────────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── Sections ──────────────────────────────────────────────────────── */
  /* Deliberately roomier than the shared .section in SiteLayout: the landing page's
     sections are fewer and longer. .section-title comes from SiteLayout unchanged. */
  .section {
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  /* ─── Get involved ──────────────────────────────────────────────────── */
  .involved-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .involved-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
  }

  .involved-list li:last-child .involved-link { border-bottom: 1px solid var(--border); }

  .involved-link-text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* Section-title size: big enough to read as the page's three ways in, without
     outweighing the events above. */
  .involved-link-title {
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    transition: color 0.2s ease;
  }

  .involved-link-sub {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .involved-link svg {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.35);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .involved-link:hover svg { transform: translateX(4px); }
  .involved-link[data-accent="blue"]:hover   .involved-link-title,
  .involved-link[data-accent="blue"]:hover   svg { color: var(--blue-text); }
  .involved-link[data-accent="green"]:hover  .involved-link-title,
  .involved-link[data-accent="green"]:hover  svg { color: var(--green-text); }
  .involved-link[data-accent="yellow"]:hover .involved-link-title,
  .involved-link[data-accent="yellow"]:hover svg { color: var(--yellow-text); }

  /* ─── Community (dark typographic) ──────────────────────────────────── */
  .section-community {
    background: var(--ink);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .community-label {
    font-family: var(--sans);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1.5rem;
  }

  .community-links-big {
    display: flex;
    flex-direction: column;
  }

  .big-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: white;
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    transition: color 0.2s ease;
  }

  .big-link:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.1); }

  .big-link svg {
    flex-shrink: 0;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .big-link:hover svg { opacity: 1; transform: translate(0, 0); }
  .big-link[data-accent="meetup"]:hover   { color: #E51937; }
  .big-link[data-accent="linkedin"]:hover { color: #0A66C2; }
  .big-link[data-accent="instagram"]:hover span {
    background: linear-gradient(90deg, #F58529, #DD2A7B, #8134AF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .big-link[data-accent="instagram"]:hover svg { color: #DD2A7B; }

  /* ─── About ─────────────────────────────────────────────────────────── */
  .about-wrap {
    max-width: 720px;
  }

  .about-body .section-title {
    margin-bottom: 1.5rem;
  }

  .about-text-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* About 75 characters a line; ch runs wide in Google Sans, so this is in rem. */
  .about-text-group p {
    max-width: 37rem;
    font-size: 1.05rem;
    line-height: 1.78;
    color: var(--text-soft);
    font-weight: 400;
  }

  .about-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--muted);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.15s ease;
  }

  .about-link:hover { gap: 0.7rem; color: var(--fg); }

  .about-link-primary {
    color: var(--blue-text);
  }

  .about-link-primary:hover { color: var(--blue-text); }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  /* 44px tall so it's a real tap target next to the Join button, not a 21px text line. */
  .hero-speak-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-speak-link:hover { color: var(--blue-text); }

  /* Next meetup: one line under the actions answering "when and where". Fixed height in
     every state (loading, scheduled, nothing scheduled), so the hero doesn't move. */
  .next-meetup {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1.25rem;
    align-items: center;
    min-height: 4.25rem;
    max-width: 560px;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.5s;
  }

  .next-meetup-line {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .next-meetup-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .next-meetup-title:hover { text-decoration: underline; text-underline-offset: 4px; }

  .next-meetup-when {
    font-size: 0.95rem;
    color: var(--text-soft);
  }

  .next-meetup-line--quiet {
    font-size: 1rem;
    color: var(--text-soft);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
  }

  .next-meetup-rsvp {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding-inline: 1.2rem;
    border-radius: 100px;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .next-meetup-rsvp:hover { border-color: var(--fg); background: rgba(255, 255, 255, 0.04); }

  .next-meetup--loading { align-content: center; row-gap: 0.5rem; }
  .skeleton-next-line { width: min(360px, 80%); height: 1.05rem; grid-column: 1 / -1; }
  .skeleton-next-when { width: min(260px, 60%); height: 0.95rem; grid-column: 1 / -1; }

  /* ─── CTA ───────────────────────────────────────────────────────────── */
  .section-cta {
    background: var(--blue);
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-heading {
    font-size: clamp(1.5rem, 3.2vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: white;
    margin-bottom: 0.5rem;
  }

  /* Full white: any transparency on the core blue drops it well below 3:1. */
  .cta-sub {
    font-size: 1.1rem;
    color: white;
    max-width: 42ch;
  }

  .btn-cta-join {
    display: inline-flex;
    align-items: center;
    padding: 0.85em 2em;
    border-radius: 100px;
    background: white;
    color: var(--on-accent);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .btn-cta-join:hover { opacity: 0.9; }

  /* ─── Events ───────────────────────────────────────────────────────── */
  .section-events {
    background: var(--bg);
  }

  .events-empty {
    max-width: 640px;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .events-empty-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 0.6rem;
  }

  .events-empty-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 52ch;
    margin-bottom: 1.5rem;
  }

  .events-empty-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }

  .events-empty-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-underline-offset: 4px;
  }
  .events-empty-link:hover { text-decoration-color: var(--fg); }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .event-card {
    background: var(--surface);
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .event-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }

  .event-card-body {
