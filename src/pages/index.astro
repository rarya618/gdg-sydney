---
import SiteLayout from '../layouts/SiteLayout.astro';
import UpcomingEvents from '../components/UpcomingEvents';
import AboutStats from '../components/AboutStats';
import PastEvents from '../components/PastEvents';
import Team from '../components/Team';
import Partners from '../components/Partners';
---

<SiteLayout
  title="GDG Sydney | Learn. Build. Connect."
  description="Google Developer Group Sydney runs free monthly meetups for developers, with talks on AI, Google Cloud and app development. Run by local organisers since 2013, and every experience level is welcome."
  ogDescription="Free monthly meetups for Sydney's developers, with talks from Googlers, Google Developer Experts and local engineers. More than 2,400 members since 2013."
  ogImage="/operaHouse.png"
  ogImageAlt="Sydney Opera House illustration"
>
  <!-- Events, team and partners load from Bevy; its images come from Cloudinary. -->
  <link rel="preconnect" href="https://gdg.community.dev" slot="head" />
  <link rel="preconnect" href="https://res.cloudinary.com" slot="head" />

  <!-- ════════════════════════════════ HERO ════════════════════════════════ -->
  <section class="hero" id="home" aria-labelledby="hero-heading" data-hero>
    <div class="hero-illustration" aria-hidden="true">
      <div class="hero-photos">
        <img src="/hero-crowd.jpg" alt="" width="1500" height="1000" fetchpriority="high" class="hero-photo hero-photo-back" />
        <img src="/hero-talk.jpg" alt="" width="1500" height="1002" fetchpriority="high" class="hero-photo hero-photo-front" />
      </div>
    </div>

    <div class="container">
      <div class="hero-content">
        <h1 class="hero-heading" id="hero-heading">
          Learn. Build.<br />Connect.
        </h1>
        <p class="hero-body">
          Free monthly meetups for Sydney's developers, with talks on AI, Google
          Cloud and app development from Googlers, Google Developer Experts and
          local engineers. Food and drinks are on us, and every level is welcome.
        </p>
        <div class="hero-actions">
          <a
            href="https://gdg.community.dev/gdg-sydney/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-lg"
          >
            Join the community
          </a>
          <a href="/speak" class="hero-speak-link">
            Speak at a meetup <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ UPCOMING EVENTS ══════════════════════════ -->
  <UpcomingEvents client:load />

  <!-- ══════════════════════════ ABOUT + STATS ═════════════════════════════ -->
  <AboutStats client:load />

  <!-- ══════════════════════════ PAST EVENTS ══════════════════════════════ -->
  <PastEvents client:load />

  <!-- ══════════════════════════════ TEAM ═════════════════════════════════ -->
  <Team client:load />

  <!-- ══════════════════════════ COMMUNITY LINKS ═══════════════════════════ -->
  <section class="section-community" id="community" aria-label="Find us online">
    <div class="container">
      <p class="community-label">Find us online</p>
      <nav class="community-links-big">
        <a href="https://www.meetup.com/gdgcloudsydney/" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="meetup">
          <span>Meetup</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="linkedin">
          <span>LinkedIn</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://www.instagram.com/gdgsydney" target="_blank" rel="noopener noreferrer" class="big-link" data-accent="instagram">
          <span>Instagram</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </nav>
    </div>
  </section>

  <!-- ══════════════════════════════ PARTNERS ═════════════════════════════ -->
  <Partners client:load />


  <!-- ════════════════════════════════ CTA ════════════════════════════════ -->
  <section class="section section-cta" aria-label="Join the community">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2 class="cta-heading">See you at the next meetup.</h2>
        <p class="cta-sub">Join GDG Sydney on our community page to hear about each meetup as it's announced.</p>
      </div>
      <a href="https://gdg.community.dev/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="btn-cta-join">
        Join the community
      </a>
    </div>
  </section>
</SiteLayout>

<style is:global>
  /* ─── Hero ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    /* The landing page is the one deliberate exception to the shared --hero-h: it gets a
       taller hero on larger screens. Phones use the shared height (see the 640px rule). */
    min-height: min(100svh, 980px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-illustration {
    position: absolute;
    right: clamp(24px, 4vw, 72px);
    top: 0;
    bottom: 0;
    height: max-content;
    margin-block: auto;
    width: clamp(340px, 40vw, 560px);
    pointer-events: none;
    z-index: 0;
    animation: fadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.45s;
  }

  .hero-illustration svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-photos {
    position: relative;
  }

  .hero-photo {
    display: block;
    width: 78%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.35);
  }

  .hero-photo-back {
    margin-left: auto;
    rotate: 3deg;
  }

  .hero-photo-front {
    position: relative;
    z-index: 1;
    margin-top: -16%;
    rotate: -4deg;
    border: 4px solid var(--bg);
  }

  .hero .container {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--header-h) + 1rem);
    padding-bottom: 2rem;
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-heading {
    font-size: clamp(2.75rem, 6.5vw, 5.25rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--fg);
    margin-bottom: 1.5rem;
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.1s;
  }

  .hero-body {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.72;
    color: var(--muted);
    margin-bottom: 2.5rem;
    max-width: 480px;
    font-weight: 400;
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.25s;
  }

  .hero .btn {
    animation: fadeUp 0.65s ease both;
    animation-delay: 0.4s;
  }

  /* ─── Keyframes ─────────────────────────────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── Sections ──────────────────────────────────────────────────────── */
  .section {
    padding-block: clamp(4.5rem, 8vw, 7rem);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--fg);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  /* ─── Community (dark typographic) ──────────────────────────────────── */
  .section-community {
    background: var(--ink);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .community-label {
    font-family: var(--sans);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1.5rem;
  }

  .community-links-big {
    display: flex;
    flex-direction: column;
  }

  .big-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-decoration: none;
    color: white;
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    transition: color 0.2s ease;
  }

  .big-link:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.1); }

  .big-link svg {
    flex-shrink: 0;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .big-link:hover svg { opacity: 1; transform: translate(0, 0); }
  .big-link[data-accent="meetup"]:hover   { color: #E51937; }
  .big-link[data-accent="linkedin"]:hover { color: #0A66C2; }
  .big-link[data-accent="instagram"]:hover span {
    background: linear-gradient(90deg, #F58529, #DD2A7B, #8134AF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .big-link[data-accent="instagram"]:hover svg { color: #DD2A7B; }

  /* ─── About ─────────────────────────────────────────────────────────── */
  .about-wrap {
    max-width: 720px;
  }

  .about-body .section-title {
    margin-bottom: 1.5rem;
  }

  .about-text-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .about-text-group p {
    font-size: 1.05rem;
    line-height: 1.78;
    color: var(--text-soft);
    font-weight: 400;
  }

  .about-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--muted);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.15s ease;
  }

  .about-link:hover { gap: 0.7rem; color: var(--fg); }

  .about-link-primary {
    color: var(--blue-text);
  }

  .about-link-primary:hover { color: var(--blue-text); }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .hero-speak-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .hero-speak-link:hover { color: var(--blue-text); }

  /* ─── CTA ───────────────────────────────────────────────────────────── */
  .section-cta {
    background: var(--blue);
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-heading {
    font-size: clamp(1.5rem, 3.2vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: white;
    margin-bottom: 0.5rem;
  }

  .cta-sub {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.75);
    max-width: 42ch;
  }

  .btn-cta-join {
    display: inline-flex;
    align-items: center;
    padding: 0.85em 2em;
    border-radius: 100px;
    background: white;
    color: var(--blue);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .btn-cta-join:hover { opacity: 0.9; }

  /* ─── Events ───────────────────────────────────────────────────────── */
  .section-events {
    background: var(--bg);
  }

  /* Shown while Bevy loads: the four brand dots pulse in turn. They grow and fade in place
     rather than bouncing, so the row stays on one line, and they start where the event
     cards or empty state will, directly under the heading. With reduced motion the global
     rule stops the animation and they simply sit still. */
  .events-loader {
    display: flex;
    gap: 8px;
    align-items: center;
    height: 1.5rem;
  }

  .events-loader-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    animation: events-loader-pulse 1.2s ease-in-out infinite;
  }
  .events-loader-dot--blue   { background: var(--blue); }
  .events-loader-dot--red    { background: var(--red);    animation-delay: 0.15s; }
  .events-loader-dot--yellow { background: var(--yellow); animation-delay: 0.3s; }
  .events-loader-dot--green  { background: var(--green);  animation-delay: 0.45s; }

  @keyframes events-loader-pulse {
    0%, 60%, 100% { transform: scale(0.75); opacity: 0.45; }
    30%           { transform: scale(1); opacity: 1; }
  }

  .events-empty {
    max-width: 640px;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }

  .events-empty-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 0.6rem;
  }

  .events-empty-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 52ch;
    margin-bottom: 1.5rem;
  }

  .events-empty-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }

  .events-empty-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-underline-offset: 4px;
  }
  .events-empty-link:hover { text-decoration-color: var(--fg); }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .event-card {
    background: var(--surface);
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .event-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }

  .event-card-accent {
    height: 4px;
    width: 100%;
  }

  .event-card--blue .event-card-accent { background: var(--blue); }
  .event-card--green .event-card-accent { background: var(--green); }
  .event-card--yellow .event-card-accent { background: var(--yellow); }
  .event-card--red .event-card-accent { background: var(--red); }

  .event-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
  }

  .event-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }

  .event-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .event-tag::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .event-card--blue .event-tag { color: var(--blue-text); }
  .event-card--blue .event-tag::before { background: var(--blue); }
  .event-card--green .event-tag { color: var(--green-text); }
  .event-card--green .event-tag::before { background: var(--green); }
  .event-card--yellow .event-tag { color: var(--yellow-text); }
  .event-card--yellow .event-tag::before { background: var(--yellow); }
  .event-card--red .event-tag { color: var(--red-text); }
  .event-card--red .event-tag::before { background: var(--red); }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .event-date {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }

  .event-time {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.65;
  }

  .event-time::before {
    content: '·';
    margin-right: 0.35rem;
  }

  .event-title {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--fg);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .event-desc {
    font-size: 0.83rem;
    color: var(--muted);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .event-rsvp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.6em 1.4em;
    border-radius: 100px;
    font-size: 0.83rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .event-card--blue .event-rsvp {
    background: var(--blue);
    color: white;
    box-shadow: 0 1px 6px rgba(66, 133, 244, 0.28);
  }
  .event-card--blue .event-rsvp:hover {
    box-shadow: 0 4px 18px rgba(66, 133, 244, 0.42);
    transform: translateY(-1px);
  }

  .event-card--green .event-rsvp {
    background: var(--green);
    color: white;
    box-shadow: 0 1px 6px rgba(52, 168, 83, 0.28);
  }
  .event-card--green .event-rsvp:hover {
    box-shadow: 0 4px 18px rgba(52, 168, 83, 0.42);
    transform: translateY(-1px);
  }

  .event-card--yellow .event-rsvp {
    background: var(--yellow);
    color: white;
    box-shadow: 0 1px 6px rgba(249, 171, 0, 0.28);
  }
  .event-card--yellow .event-rsvp:hover {
    box-shadow: 0 4px 18px rgba(249, 171, 0, 0.42);
    transform: translateY(-1px);
  }

  .event-card--red .event-rsvp {
    background: var(--red);
    color: white;
    box-shadow: 0 1px 6px rgba(234, 67, 53, 0.28);
  }
  .event-card--red .event-rsvp:hover {
    box-shadow: 0 4px 18px rgba(234, 67, 53, 0.42);
    transform: translateY(-1px);
  }

  /* ─── Past Events ──────────────────────────────────────────────────── */
  .section-past {
    border-top: 1px solid var(--border);
  }

  /* ─── Stats ─────────────────────────────────────────────────────────── */
  .section-stats {
    background: var(--ink);
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    max-width: 860px;
    margin-inline: auto;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    padding-inline: 1.5rem;
    position: relative;
  }

  .stat + .stat::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 64px;
    background: rgba(255, 255, 255, 0.12);
  }

  .stat-num {
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: white;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
  }

  @media (max-width: 560px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .stat + .stat::before {
      left: 50%;
      top: 0;
      transform: translateX(-50%);
      width: 48px;
      height: 1px;
    }
  }

  .past-list {
    display: flex;
    flex-direction: column;
  }

  .past-item {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
    border-radius: 8px;
    padding-inline: 0.5rem;
    margin-inline: -0.5rem;
  }

  .past-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .past-item:hover {
    background: var(--surface);
  }

  .past-tag {
    font-size: 0.68rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .past-tag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .past-tag--blue  { color: var(--blue-text);  }
  .past-tag--blue::before  { background: var(--blue);  }
  .past-tag--green { color: var(--green-text); }
  .past-tag--green::before { background: var(--green); }
  .past-tag--yellow { color: var(--yellow-text); }
  .past-tag--yellow::before { background: var(--yellow); }
  .past-tag--red { color: var(--red-text); }
  .past-tag--red::before { background: var(--red); }

  .past-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg);
    line-height: 1.4;
  }

  .past-date {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Phones: the three columns squeezed the title into a narrow strip, so the tag and date
     share the top line and the title gets the full width underneath. */
  @media (max-width: 640px) {
    .past-item {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'tag date'
