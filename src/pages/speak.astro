---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import FormattingHelp from '../components/FormattingHelp.astro';
// A speaker presenting at a past DevFest Sydney.
import heroPhoto from '../assets/speak/hero.jpg';

// The speaker portal in the GDG Sydney back office (app.gdgsydney.com): proposals, edits and
// the speaker profile, signed in by an emailed link. Its sign-in page, never a sign-in link.
const PORTAL_SIGN_IN_URL = 'https://app.gdgsydney.com/speaker/sign-in';
---

<SiteLayout
  title="Speak at GDG Sydney | Google Developer Group"
  ogTitle="Speak at GDG Sydney"
  description="Propose a talk or workshop for a GDG Sydney meetup: a 20 to 30 minute talk or a 60 to 90 minute hands-on workshop. First-time speakers are welcome, and we reply within a week."
  ogDescription="Give a talk or run a workshop at a GDG Sydney meetup. First-time speakers welcome, and we reply within a week."
  current="speak"
>

  <!-- ══════════════════════════════ MASTHEAD ══════════════════════════════ -->
  <section class="speak-masthead" aria-labelledby="speak-heading" data-hero>
    <Image
      src={heroPhoto}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      class="speak-masthead-photo"
      loading="eager"
      fetchpriority="high"
    />
    <div class="speak-masthead-scrim" aria-hidden="true"></div>
    <div class="container">
      <div class="speak-masthead-inner">
        <div class="speak-masthead-text">
          <h1 class="speak-heading" id="speak-heading">
            Share your<br />knowledge.
          </h1>
          <p class="speak-subheading">
            Speak at a GDG Sydney meetup. We reply within a week.
          </p>
          <a href="#propose" class="speak-jump">
            Propose a talk
            <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .75.75v10.638l3.96-4.158a.75.75 0 1 1 1.08 1.04l-5.25 5.5a.75.75 0 0 1-1.08 0l-5.25-5.5a.75.75 0 1 1 1.08-1.04l3.96 4.158V3.75A.75.75 0 0 1 10 3Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
        <div class="speak-stats" aria-label="Community stats">
          <div class="stat">
            <span class="stat-value">2,400<span class="stat-plus">+</span></span>
            <span class="stat-label">Members</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat">
            <span class="stat-value">Monthly</span>
            <span class="stat-label">Meetups</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat">
            <span class="stat-value">All</span>
            <span class="stat-label">Levels</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ MAIN ═════════════════════════════════ -->
  <div class="speak-body">
    <div class="container">
      <div class="speak-layout">

        <!-- The form comes first in the source, so phones and screen readers reach it before
             the sidebar. On wide screens the grid puts the sidebar back on the left. -->
        <section class="speak-form-wrap" id="propose" aria-labelledby="form-heading">
          <h2 class="form-heading" id="form-heading">Submit a talk proposal</h2>
          <p class="form-portal-note">
            Already proposed, or spoken for us before? <a href={PORTAL_SIGN_IN_URL} target="_blank" rel="noopener" class="form-note-link">Sign in to the speaker portal</a> to follow and change your proposals and keep your speaker profile up to date.
          </p>

          <form
            class="speak-form"
            novalidate
            id="speaker-form"
          >

            <!-- Honeypot: hidden from people and screen readers; bots that fill it are ignored. -->
            <div class="hp-field" aria-hidden="true">
              <label>Company website <input type="text" name="companyWebsite" tabindex="-1" autocomplete="off" /></label>
            </div>

            <!-- The talk first, so the form starts with the idea rather than the person. Field
                 names, and the maxlength values, match the devfest-sydney API
                 (src/lib/meetupProposalLabels.ts), the WebMCP tool below and /llms.txt. -->
            <fieldset class="form-group">
              <legend class="form-group-title">Your talk</legend>

              <div class="field">
                <label for="title" class="field-label">Title <span class="required" aria-hidden="true">*</span></label>
                <input
                  id="title"
                  name="title"
                  type="text"
                  class="field-input"
                  placeholder="e.g. Building RAG apps with Vertex AI"
                  maxlength="200"
                  autocomplete="off"
                  aria-describedby="title-error"
                  required
                />
                <p class="field-error" id="title-error"></p>
              </div>

              <fieldset class="field" aria-describedby="format-hint format-error">
                <legend class="field-label">Format <span class="required" aria-hidden="true">*</span></legend>
                <p class="field-hint" id="format-hint">Not sure? Pick a standard talk.</p>
                <div class="radio-group">
                  <label class="radio-card">
                    <input type="radio" name="format" value="standard" required />
                    <span class="radio-inner">
                      <span class="radio-name">Standard talk</span>
                      <span class="radio-sub">20 to 30 minutes, with time for questions</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="format" value="workshop" required />
                    <span class="radio-inner">
                      <span class="radio-name">Workshop</span>
                      <span class="radio-sub">60 to 90 minutes, hands-on</span>
                    </span>
                  </label>
                </div>
                <p class="field-error" id="format-error"></p>
              </fieldset>

              <div class="field">
                <label for="abstract" class="field-label">
                  Abstract <span class="required" aria-hidden="true">*</span>
                </label>
                <p class="field-hint" id="abstract-hint">
                  What will attendees learn? What problem does it solve? 2 to 4 sentences is ideal.
                </p>
                <details class="field-example">
                  <summary>See an example abstract</summary>
                  <p>
                    Retrieval-augmented generation lets a model answer from your own documents
                    instead of guessing. In this talk I'll build a small RAG app on Vertex AI live,
                    from splitting and embedding a set of docs to grounding Gemini's answers in
                    them and citing the sources. You'll leave knowing when RAG is worth the effort,
                    the mistakes that make its answers worse, and a starter repo to try on your
                    own data.
                  </p>
                </details>
                <textarea
                  id="abstract"
                  aria-describedby="abstract-hint abstract-error"
                  name="abstract"
                  class="field-input field-textarea"
                  placeholder="Start with the problem, then what people will take away."
                  rows="6"
                  maxlength="2000"
                  required
                ></textarea>
                <p class="field-error" id="abstract-error"></p>
                <FormattingHelp for="abstract" label="talk abstract" />
              </div>

              <div class="field">
                <label for="audience" class="field-label">
                  Target audience <span class="required" aria-hidden="true">*</span>
                </label>
                <p class="field-hint" id="audience-hint">Who will get the most out of it? What experience should they have?</p>
                <textarea
                  id="audience"
                  aria-describedby="audience-hint audience-error"
                  name="audience"
                  class="field-input field-textarea"
                  placeholder="e.g. Developers curious about AI, no prior ML experience needed. Or: backend engineers familiar with distributed systems."
                  rows="3"
                  maxlength="1000"
                  required
                ></textarea>
                <p class="field-error" id="audience-error"></p>
                <FormattingHelp for="audience" label="target audience" />
              </div>
            </fieldset>

            <fieldset class="form-group">
              <legend class="form-group-title">About you</legend>

              <div class="field-row">
                <div class="field">
                  <label for="name" class="field-label">Full name <span class="required" aria-hidden="true">*</span></label>
                  <input
                    id="name"
                    name="name"
                    type="text"
                    class="field-input"
                    placeholder="e.g. Alex Chen"
                    maxlength="120"
                    aria-describedby="name-error"
                    required
                    autocomplete="name"
                  />
                  <p class="field-error" id="name-error"></p>
                </div>
                <div class="field">
                  <label for="email" class="field-label">Email <span class="required" aria-hidden="true">*</span></label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    class="field-input"
                    placeholder="e.g. alex@example.com"
                    maxlength="254"
                    spellcheck="false"
                    aria-describedby="email-error"
                    required
                    autocomplete="email"
                  />
                  <p class="field-error" id="email-error"></p>
                </div>
              </div>

              <!-- Plain text with a URL keyboard: the API adds https:// itself, so a bare
                   "linkedin.com/in/you" is fine and the browser's stricter url check isn't. -->
              <div class="field">
                <label for="profile" class="field-label">
                  LinkedIn or website
                  <span class="field-optional">(optional)</span>
                </label>
                <input
                  id="profile"
                  name="profile"
                  type="text"
                  inputmode="url"
                  autocapitalize="off"
                  spellcheck="false"
                  class="field-input"
                  placeholder="e.g. linkedin.com/in/yourname"
                  maxlength="300"
                  aria-describedby="profile-error"
                  autocomplete="url"
                />
                <p class="field-error" id="profile-error"></p>
              </div>

              <div class="field">
                <label for="bio" class="field-label">
                  Speaker bio <span class="required" aria-hidden="true">*</span>
                </label>
                <p class="field-hint" id="bio-hint">A few sentences about you and what you work on. Your role and what you're into is plenty.</p>
                <textarea
                  id="bio"
                  aria-describedby="bio-hint bio-error"
                  name="bio"
                  class="field-input field-textarea"
                  placeholder="e.g. I'm a software engineer at … and I spend most of my time on …"
                  rows="3"
                  maxlength="2000"
                  required
                ></textarea>
                <p class="field-error" id="bio-error"></p>
                <FormattingHelp for="bio" label="speaker bio" />
              </div>

              <div class="field">
                <label for="experience" class="field-label">
                  Speaking experience
                  <span class="field-optional">(optional)</span>
                </label>
                <textarea
                  id="experience"
                  aria-describedby="experience-error"
                  name="experience"
                  class="field-input field-textarea"
                  placeholder="Have you spoken at meetups or conferences before? Doesn't matter if not. First-time speakers are very welcome."
                  rows="3"
                  maxlength="1000"
                ></textarea>
                <p class="field-error" id="experience-error"></p>
                <FormattingHelp for="experience" label="speaking experience" />
              </div>
            </fieldset>

            <fieldset class="form-group">
              <legend class="form-group-title">Anything else</legend>
              <div class="field">
                <label for="notes" class="field-label">
                  Notes for the organisers
                  <span class="field-optional">(optional)</span>
                </label>
                <textarea
                  id="notes"
                  aria-describedby="notes-error"
                  name="notes"
                  class="field-input field-textarea"
                  placeholder="Preferred dates, AV requirements, co-presenter, etc."
                  rows="3"
                  maxlength="1000"
                ></textarea>
                <p class="field-error" id="notes-error"></p>
                <FormattingHelp for="notes" label="notes" />
              </div>
            </fieldset>

            <div class="form-footer">
              <p class="form-note">
                <span class="required" aria-hidden="true">*</span> Required.
                You'll get a confirmation email, and a reply within a week. You can change your
                proposal afterwards in the speaker portal.{' '}
                <a href="/privacy" target="_blank" rel="noopener" class="form-note-link">How we use your details</a>
              </p>
              <p class="draft-status" id="draft-status"></p>
              <button type="submit" class="btn btn-primary btn-submit" id="submit-btn">
                Send my proposal
                <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>

            <!-- Always in the page and filled in by the script, so screen readers announce it. -->
            <div class="form-error" id="form-error" role="alert"></div>

          </form>

          <div class="form-success" id="form-success" hidden>
            <div class="success-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
                <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="success-title" id="success-title" tabindex="-1">Proposal received</h3>
            <p class="success-body">
              Thanks for putting your hand up. A confirmation email is on its way to{' '}<strong id="success-email">your inbox</strong>, and we'll reply within a week.
            </p>
            <p class="success-body">
              Follow it, or make changes until we've decided, in the <a href={PORTAL_SIGN_IN_URL} class="form-note-link">speaker portal</a>. Sign in with the email you used.
            </p>
          </div>

          <p class="form-agent-note">
            Drafting with an AI assistant? It can send your proposal for you by following our <a href="/llms.txt" target="_blank" rel="noopener" class="form-note-link">instructions for agents</a>. Check what it writes before it goes.
          </p>
        </section>

        <aside class="speak-info" aria-label="Why speak at GDG Sydney">

          <div class="info-block">
            <h2 class="info-label">Why speak?</h2>
            <ul class="info-list" role="list">
              <li class="info-item">
                <span class="info-dot" style="background: var(--blue)"></span>
                Talk to a room of developers who came to learn
              </li>
              <li class="info-item">
                <span class="info-dot" style="background: var(--green)"></span>
                Get known in Sydney's developer community
              </li>
              <li class="info-item">
                <span class="info-dot" style="background: var(--yellow)"></span>
                First-time speakers are welcome
              </li>
              <li class="info-item">
                <span class="info-dot" style="background: var(--red)"></span>
                Your topic doesn't have to be a Google product
              </li>
            </ul>
          </div>

          <!-- Replaces a pair of static format cards that repeated the form's own choice. -->
          <div class="info-block">
            <h2 class="info-label">What happens next</h2>
            <ol class="next-steps" role="list">
              <li>
                <span class="next-step-num" aria-hidden="true">1</span>
                <span><strong>You get a confirmation email</strong> as soon as it's sent.</span>
              </li>
              <li>
                <span class="next-step-num" aria-hidden="true">2</span>
                <span><strong>An organiser reads it</strong> and replies within a week.</span>
              </li>
              <li>
                <span class="next-step-num" aria-hidden="true">3</span>
                <span><strong>You can change it</strong> in the speaker portal until we've decided.</span>
              </li>
            </ol>
          </div>

          <div class="info-block">
            <h2 class="info-label">Questions?</h2>
            <a href="mailto:hello@gdgsydney.com" class="info-email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15" height="15" aria-hidden="true">
                <path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              hello@gdgsydney.com
            </a>
          </div>

        </aside>

      </div>
    </div>
  </div>

  <script>
    import { formattingPrompt } from '../lib/formattingPrompt';

    // Proposals go to the back office's /api/submit-meetup-proposal (app.gdgsydney.com), which validates them,
    // saves them to Firestore (meetupProposals) and emails a confirmation, bcc'd to
    // hello@gdgsydney.com.
    const PROPOSAL_URL = import.meta.env.PUBLIC_MEETUP_PROPOSAL_URL;

    const form = document.getElementById('speaker-form') as HTMLFormElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successEl = document.getElementById('form-success') as HTMLElement;
    const successTitle = document.getElementById('success-title') as HTMLElement;
    const successEmail = document.getElementById('success-email') as HTMLElement;
    const errorEl = document.getElementById('form-error') as HTMLElement;
    const draftStatus = document.getElementById('draft-status') as HTMLElement;
    const buttonContent = btn.innerHTML;

    // ── Field errors ─────────────────────────────────────────────────────
    // Each field has an empty <p class="field-error"> its aria-describedby already points at,
    // so filling it in is what a screen reader reads on focus. Errors show once a field has
    // been edited and left, and for every field on submit.

    type Control = HTMLInputElement | HTMLTextAreaElement;
    const FIELDS = ['title', 'format', 'abstract', 'audience', 'name', 'email', 'profile', 'bio', 'experience', 'notes'] as const;
    type FieldName = (typeof FIELDS)[number];
    const LABELS: Record<FieldName, string> = {
      title: 'a title',
      format: 'a format',
      abstract: 'an abstract',
      audience: 'who it’s for',
      name: 'your name',
      email: 'your email',
      profile: 'a link',
      bio: 'a short bio',
      experience: 'your experience',
      notes: 'your notes',
    };

    const controlsFor = (name: FieldName): Control[] =>
      Array.from(form.querySelectorAll<Control>(`[name="${name}"]`));

    const messageFor = (name: FieldName): string => {
      const [control] = controlsFor(name);
      const { validity } = control;
      if (validity.valid) return '';
      if (name === 'format') return 'Choose a standard talk or a workshop.';
      if (validity.valueMissing) return `Add ${LABELS[name]}.`;
      if (validity.typeMismatch && name === 'email') return 'Enter an email address, like name@example.com.';
      if (validity.tooLong) return `Keep it to ${control.maxLength} characters or fewer.`;
      return control.validationMessage;
    };

    const setError = (name: FieldName, message: string) => {
      const errorText = document.getElementById(`${name}-error`);
      if (errorText) errorText.textContent = message;
      controlsFor(name).forEach((control) => {
        if (message) control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
      });
    };

    const checkField = (name: FieldName) => setError(name, messageFor(name));

    // Marks every invalid field and moves focus to the first one. True when all are valid.
    const checkAll = (): boolean => {
      let first: Control | undefined;
      for (const name of FIELDS) {
        checkField(name);
        if (!first && messageFor(name)) first = controlsFor(name)[0];
      }
      first?.focus();
      return !first;
    };

    const edited = new Set<string>();
    const onEdit = (event: Event) => {
      const target = event.target as Control;
      if (!(FIELDS as readonly string[]).includes(target.name)) return;
      edited.add(target.name);
      // Once an error is showing, clear it as soon as the field is fixed.
      if (target.getAttribute('aria-invalid') === 'true') checkField(target.name as FieldName);
    };
    // Radios report a choice as a change; text fields as input.
    form.addEventListener('input', onEdit);
    form.addEventListener('change', onEdit);
    form.addEventListener('focusout', (event) => {
      const target = event.target as Control;
      if (edited.has(target.name)) checkField(target.name as FieldName);
    });

    // The API's 400 messages start with the field's label (src/lib/proposalFiling.ts in
    // devfest-sydney), so they can be shown under the field they're about.
    const SERVER_LABELS: [string, FieldName][] = [
      ['Full name', 'name'],
      ['A valid email', 'email'],
      ['Email', 'email'],
      ['LinkedIn or website', 'profile'],
      ['Talk title', 'title'],
      ['Please choose a talk format', 'format'],
      ['Talk abstract', 'abstract'],
      ['Target audience', 'audience'],
      ['Speaker bio', 'bio'],
      ['Speaking experience', 'experience'],
      ['Anything else', 'notes'],
    ];
    const fieldForServerMessage = (message: string): FieldName | undefined =>
      SERVER_LABELS.find(([label]) => message.startsWith(label))?.[1];

    // ── Draft, kept on this device ───────────────────────────────────────
    // A proposal can take a while to write, so what's typed is kept in this browser until it's
    // sent, and comes back after a reload or a wander off the page. Never sent anywhere. Storage
    // can be blocked (private windows, strict settings), so every access is guarded and the
    // form works the same without it.

    const DRAFT_KEY = 'gdg-speak-draft-v1';
    const timeFormat = new Intl.DateTimeFormat('en-AU', { hour: 'numeric', minute: '2-digit' });

    const readDraft = (): Record<string, string> | null => {
      try {
        const saved = JSON.parse(localStorage.getItem(DRAFT_KEY) ?? 'null');
        return saved && typeof saved === 'object' ? saved : null;
      } catch {
        return null;
      }
    };

    let saveTimer: number | undefined;

    const saveDraft = () => {
      // Once it's sent, a save still queued from the last keystroke mustn't bring the draft back.
      if (form.hidden) return;
      const values: Record<string, string> = {};
      for (const name of FIELDS) {
        const value = name === 'format'
          ? form.querySelector<HTMLInputElement>('input[name="format"]:checked')?.value ?? ''
          : controlsFor(name)[0].value;
        if (value) values[name] = value;
      }
      try {
        if (Object.keys(values).length) {
          localStorage.setItem(DRAFT_KEY, JSON.stringify(values));
          draftStatus.textContent = `Draft saved on this device at ${timeFormat.format(new Date())}.`;
        } else {
          localStorage.removeItem(DRAFT_KEY);
          draftStatus.textContent = '';
        }
      } catch {
        // Storage blocked: nothing to say, and the form still sends.
      }
    };

    const clearDraft = () => {
      window.clearTimeout(saveTimer);
      try { localStorage.removeItem(DRAFT_KEY); } catch { /* blocked */ }
      draftStatus.textContent = '';
    };

    form.addEventListener('input', () => {
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(saveDraft, 400);
    });
    form.addEventListener('change', saveDraft);

    // Restore into empty fields only, so a browser's own form restore is never overwritten.
    const draft = readDraft();
    if (draft) {
      let restored = false;
      for (const name of FIELDS) {
        const value = draft[name];
        if (typeof value !== 'string' || !value) continue;
        if (name === 'format') {
          const radio = form.querySelector<HTMLInputElement>(`input[name="format"][value="${CSS.escape(value)}"]`);
          if (radio && !form.querySelector('input[name="format"]:checked')) { radio.checked = true; restored = true; }
        } else {
          const [control] = controlsFor(name);
          if (!control.value) { control.value = value.slice(0, control.maxLength > 0 ? control.maxLength : undefined); restored = true; }
        }
      }
      if (restored) draftStatus.textContent = 'We kept your draft on this device. Pick up where you left off.';
    }

    // ── Sending ──────────────────────────────────────────────────────────

    const formatWait = (seconds: number) => {
      const minutes = Math.ceil(seconds / 60);
      if (minutes < 60) return `${minutes} minute${minutes === 1 ? '' : 's'}`;
      const hours = Math.ceil(minutes / 60);
      return `${hours} hour${hours === 1 ? '' : 's'}`;
    };

    // The error under the button. The draft is kept, so it always says so.
    const showError = (message: string) => {
      errorEl.replaceChildren();
      const text = document.createElement('p');
      text.className = 'error-text';
      const email = document.createElement('a');
      email.href = 'mailto:hello@gdgsydney.com';
      email.className = 'coc-link';
      email.textContent = 'hello@gdgsydney.com';
      text.append(`${message} Your draft is still here, and you can also email it to `, email, '.');
      errorEl.append(text);
      btn.disabled = false;
      btn.innerHTML = buttonContent;
    };

    // Sends whatever is in the form, for both the submit button and the agent tool below.
    // Resolves to null on success, or the message shown to the person on failure.
    const sendProposal = async (): Promise<string | null> => {
      btn.disabled = true;
      btn.textContent = 'Sending…';
      errorEl.replaceChildren();

      const data = new FormData(form);
      const field = (name: string) => String(data.get(name) ?? '').trim();
      const payload = {
        name: field('name'),
        email: field('email'),
        profileUrl: field('profile'),
        talkTitle: field('title'),
        format: field('format'),
        abstract: field('abstract'),
        audience: field('audience'),
        bio: field('bio'),
        speakingExperience: field('experience'),
        notes: field('notes'),
        companyWebsite: field('companyWebsite'),
      };

      let response: Response;
      try {
        response = await fetch(PROPOSAL_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
      } catch {
        const message = "We couldn't reach the server. Check your connection and send it again.";
        showError(message);
        return message;
      }

      if (!response.ok) {
        const body = await response.json().catch(() => null);
        let message: string = body?.message ?? 'Something went wrong on our side.';
        if (response.status === 429) {
          const wait = Number(body?.retryAfterSeconds ?? response.headers.get('Retry-After'));
          message = "We've had a lot of proposals in a short time, so we can't take this one yet." +
            (wait > 0 ? ` You can send it in about ${formatWait(wait)}.` : ' Try again later.');
        } else if (response.status === 400) {
          const fieldName = fieldForServerMessage(message);
          if (fieldName) {
            setError(fieldName, message);
            controlsFor(fieldName)[0]?.focus();
          }
        }
        showError(message);
        return message;
      }

      clearDraft();
      successEmail.textContent = payload.email;
      form.hidden = true;
      successEl.hidden = false;
      // The button that had focus is gone; put focus on the result so it's announced.
      successTitle.focus();
      return null;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!checkAll()) return;
      await sendProposal();
    });

    // "Copy a prompt" under each text box: the prompt is in src/lib/formattingPrompt.ts.

    const copyText = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Older browsers, or a page without clipboard permission.
        const scratch = document.createElement('textarea');
        scratch.value = text;
        scratch.setAttribute('readonly', '');
        scratch.style.position = 'fixed';
        scratch.style.opacity = '0';
        document.body.append(scratch);
        scratch.select();
        const copied = document.execCommand('copy');
        scratch.remove();
        return copied;
      }
    };

    document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
      const textEl = button.querySelector('.format-copy-text') as HTMLElement;
      const idleText = textEl.textContent ?? '';
      let resetTimer: number | undefined;
      button.addEventListener('click', async () => {
        const box = document.getElementById(button.dataset.copyPrompt ?? '') as HTMLTextAreaElement | null;
        const copied = await copyText(formattingPrompt(button.dataset.label ?? 'text', box?.value.trim() ?? ''));
        textEl.textContent = copied
          ? 'Copied. Paste it into your AI tool, then paste its answer back here.'
          : "Couldn't copy. Your browser blocked the clipboard.";
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => { textEl.textContent = idleText; }, 4000);
      });
    });

    // The "Formatting" tooltips: a click or tap pins one open (hover alone opens it where
    // there is hover, in CSS). Escape, or a click anywhere else, closes it.
    const tipTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.format-tip-trigger'));
    const closeTips = (except?: HTMLButtonElement) => {
      tipTriggers.forEach((trigger) => { if (trigger !== except) trigger.setAttribute('aria-expanded', 'false'); });
    };
    tipTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        closeTips(trigger);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
    });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('.format-tip')) closeTips();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = tipTriggers.find((trigger) => trigger.getAttribute('aria-expanded') === 'true');
      if (!open) return;
      closeTips();
      if (open.closest('.format-tip')?.contains(document.activeElement)) open.focus();
    });

    // WebMCP (navigator.modelContext): lets an AI agent in the person's browser submit a
    // proposal as a structured tool call instead of clicking through the form. An early
    // web standard, so this does nothing where the browser doesn't offer it. The tool fills
    // in the visible form before sending, so the person sees exactly what went, and the
    // page then shows the usual success or error message. Agents without a browser use the
    // same endpoint directly; both are described in /llms.txt.
    type ProposalInput = {
      name: string;
      email: string;
      profileUrl?: string;
      talkTitle: string;
      format: 'standard' | 'workshop';
      abstract: string;
      audience: string;
      bio: string;
      speakingExperience?: string;
      notes?: string;
    };
    type ModelContext = {
      registerTool: (tool: {
        name: string;
        description: string;
        inputSchema: object;
        execute: (input: ProposalInput) => Promise<{ content: { type: 'text'; text: string }[] }>;
      }) => unknown;
    };
    const modelContext = (navigator as Navigator & { modelContext?: ModelContext }).modelContext;

    if (modelContext && typeof modelContext.registerTool === 'function') {
      const setField = (name: string, value: string | undefined) => {
        const input = form.elements.namedItem(name);
        if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) input.value = value ?? '';
      };
      const reply = (text: string) => ({ content: [{ type: 'text' as const, text }] });

      try {
        modelContext.registerTool({
          name: 'submit_talk_proposal',
          description:
            'Submit a talk or workshop proposal for a GDG Sydney monthly meetup on behalf of the person using this browser. ' +
            'Only call this after the person has read and approved every field, and use their own name and email: the ' +
            'confirmation email goes to that address, and organisers reply to it within a week. Write in their voice. ' +
            'Formatting in abstract, audience, bio, speakingExperience and notes: lines starting with "## " are headings, ' +
            'lines starting with "- " are bullets, ' +
            '**text** is bold, [text](https://...) is a link.',
          inputSchema: {
            type: 'object',
            properties: {
              name: { type: 'string', description: "The speaker's full name.", maxLength: 120 },
              email: { type: 'string', format: 'email', description: "The speaker's email address.", maxLength: 254 },
              profileUrl: { type: 'string', description: 'Optional LinkedIn or personal website URL.', maxLength: 300 },
              talkTitle: { type: 'string', description: 'The talk title.', maxLength: 200 },
              format: {
                type: 'string',
                enum: ['standard', 'workshop'],
                description: 'standard: a 20 to 30 minute talk. workshop: a 60 to 90 minute hands-on session.',
              },
              abstract: { type: 'string', description: 'What attendees will learn and what problem it solves. 2 to 4 sentences is ideal.', maxLength: 2000 },
              audience: { type: 'string', description: 'Who will get the most out of it, and what experience they need.', maxLength: 1000 },
              bio: { type: 'string', description: 'A few sentences about the speaker and their background.', maxLength: 2000 },
              speakingExperience: { type: 'string', description: 'Optional. Past talks; first-time speakers are welcome.', maxLength: 1000 },
              notes: { type: 'string', description: 'Optional. Preferred dates, AV needs, a co-presenter.', maxLength: 1000 },
            },
            required: ['name', 'email', 'talkTitle', 'format', 'abstract', 'audience', 'bio'],
          },
          execute: async (input) => {
            if (form.hidden) return reply('A proposal was already sent from this page. Reload it to send another.');
            setField('name', input.name);
            setField('email', input.email);
            setField('profile', input.profileUrl);
            setField('title', input.talkTitle);
            setField('abstract', input.abstract);
            setField('audience', input.audience);
            setField('bio', input.bio);
            setField('experience', input.speakingExperience);
            setField('notes', input.notes);
            const formatRadio = form.querySelector<HTMLInputElement>(`input[name="format"][value="${input.format}"]`);
            if (formatRadio) formatRadio.checked = true;

            saveDraft();
            if (!checkAll()) {
              const invalid = FIELDS.find((name) => messageFor(name));
              return reply(`Not sent: the ${invalid ?? 'form'} field is missing or invalid. ${invalid ? messageFor(invalid) : ''}`.trim());
            }
            const error = await sendProposal();
            return reply(
              error
                ? `Not sent: ${error}`
                : "Sent. A confirmation email is on its way to the speaker's address, and organisers reply within a week. " +
                    'They can follow or edit the proposal at https://app.gdgsydney.com/speaker/sign-in.'
            );
          },
        });
      } catch {
        // A browser with a different version of the API: leave the form as it is.
      }
    }
  </script>
</SiteLayout>

