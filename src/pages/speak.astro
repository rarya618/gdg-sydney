---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
// A speaker presenting at a past DevFest Sydney.
import heroPhoto from '../assets/speak/hero.jpg';

// The speaker portal in the GDG Sydney back office (app.gdgsydney.com): proposals, edits and
// the speaker profile, signed in by an emailed link. Its sign-in page, never a sign-in link.
const PORTAL_SIGN_IN_URL = 'https://app.gdgsydney.com/speaker/sign-in';
---

<SiteLayout
  title="Speak at GDG Sydney | Google Developer Group"
  ogTitle="Speak at GDG Sydney"
  description="Propose a talk or workshop for a GDG Sydney meetup: a 20 to 30 minute talk or a 60 to 90 minute hands-on workshop. First-time speakers are welcome, and we reply within a week."
  ogDescription="Give a talk or run a workshop at a GDG Sydney meetup. First-time speakers welcome, and we reply within a week."
  current="speak"
>

  <!-- ══════════════════════════════ MASTHEAD ══════════════════════════════ -->
  <section class="speak-masthead" aria-labelledby="speak-heading" data-hero>
    <Image
      src={heroPhoto}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      class="speak-masthead-photo"
      loading="eager"
      fetchpriority="high"
    />
    <div class="speak-masthead-scrim" aria-hidden="true"></div>
    <div class="container">
      <div class="speak-masthead-inner">
        <div class="speak-masthead-text">
          <h1 class="speak-heading" id="speak-heading">
            Share your<br />knowledge.
          </h1>
          <p class="speak-subheading">
            Speak at a GDG Sydney meetup. We reply within a week.
          </p>
        </div>
        <div class="speak-stats" aria-label="Community stats">
          <div class="stat">
            <span class="stat-value">2,400<span class="stat-plus">+</span></span>
            <span class="stat-label">Members</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat">
            <span class="stat-value">Monthly</span>
            <span class="stat-label">Meetups</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat">
            <span class="stat-value">All</span>
            <span class="stat-label">Levels</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ MAIN ═════════════════════════════════ -->
  <div class="speak-body">
    <div class="container">
      <div class="speak-layout">

        <!-- Left: info -->
        <aside class="speak-info" aria-label="Why speak at GDG Sydney">

          <div class="info-block">
            <h2 class="info-label">Why speak?</h2>
            <ul class="info-list" role="list">
              <li class="info-item">
                <span class="info-dot" style="background: var(--blue)"></span>
                Talk to a room of developers who came to learn
              </li>
              <li class="info-item">
                <span class="info-dot" style="background: var(--green)"></span>
                Get known in Sydney's developer community
              </li>
              <li class="info-item">
                <span class="info-dot" style="background: var(--yellow)"></span>
                First-time speakers are welcome
              </li>
              <li class="info-item">
                <span class="info-dot" style="background: var(--red)"></span>
                Your topic doesn't have to be a Google product
              </li>
            </ul>
          </div>

          <div class="info-block">
            <h2 class="info-label">Talk formats</h2>
            <div class="format-cards">
              <div class="format-card">
                <span class="format-tag" style="--tag-color: var(--blue-text)">Standard</span>
                <p class="format-duration">20 to 30 min</p>
                <p class="format-desc">A full talk with time for audience questions.</p>
              </div>
              <div class="format-card">
                <span class="format-tag" style="--tag-color: var(--yellow-text)">Workshop</span>
                <p class="format-duration">60 to 90 min</p>
                <p class="format-desc">A hands-on session where attendees build along with you.</p>
              </div>
            </div>
          </div>

          <div class="info-block">
            <h2 class="info-label">Questions?</h2>
            <a href="mailto:hello@gdgsydney.com" class="info-email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15" height="15" aria-hidden="true">
                <path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              hello@gdgsydney.com
            </a>
          </div>

        </aside>

        <!-- Right: form -->
        <section class="speak-form-wrap" aria-labelledby="form-heading">
          <h2 class="form-heading" id="form-heading">Submit a talk proposal</h2>
          <p class="form-portal-note">
            Already proposed, or spoken for us before? <a href={PORTAL_SIGN_IN_URL} class="form-note-link">Sign in to the speaker portal</a> to follow and change your proposals and keep your speaker profile up to date.
          </p>
          <p class="form-portal-note">
            Drafting with an AI assistant? It can send your proposal for you by following our <a href="/llms.txt" class="form-note-link">instructions for agents</a>. Check what it writes before it goes.
          </p>

          <form
            class="speak-form"
            novalidate
            id="speaker-form"
          >

            <!-- Honeypot: hidden from people and screen readers; bots that fill it are ignored. -->
            <div class="hp-field" aria-hidden="true">
              <label>Company website <input type="text" name="companyWebsite" tabindex="-1" autocomplete="off" /></label>
            </div>

            <!-- Name + Email -->
            <div class="field-row">
              <div class="field">
                <label for="name" class="field-label">Full name <span class="required" aria-hidden="true">*</span></label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  class="field-input"
                  placeholder="Alex Chen"
                  required
                  autocomplete="name"
                />
              </div>
              <div class="field">
                <label for="email" class="field-label">Email <span class="required" aria-hidden="true">*</span></label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  class="field-input"
                  placeholder="alex@example.com"
                  spellcheck="false"
                  required
                  autocomplete="email"
                />
              </div>
            </div>

            <!-- LinkedIn / website -->
            <div class="field">
              <label for="profile" class="field-label">
                LinkedIn or website
                <span class="field-optional">(optional)</span>
              </label>
              <input
                id="profile"
                name="profile"
                type="url"
                class="field-input"
                placeholder="https://linkedin.com/in/yourname"
                autocomplete="url"
              />
            </div>

            <!-- Talk title -->
            <div class="field">
              <label for="title" class="field-label">Talk title <span class="required" aria-hidden="true">*</span></label>
              <input
                id="title"
                name="title"
                type="text"
                class="field-input"
                placeholder="e.g. Building RAG apps with Vertex AI"
                required
              />
            </div>

            <!-- Format -->
            <fieldset class="field">
              <legend class="field-label">Talk format <span class="required" aria-hidden="true">*</span></legend>
              <div class="radio-group" role="radiogroup">
                <label class="radio-card">
                  <input type="radio" name="format" value="standard" required />
                  <span class="radio-inner">
                    <span class="radio-name">Standard talk</span>
                    <span class="radio-sub">20 to 30 minutes</span>
                  </span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="format" value="workshop" required />
                  <span class="radio-inner">
                    <span class="radio-name">Workshop</span>
                    <span class="radio-sub">60 to 90 minutes</span>
                  </span>
                </label>
              </div>
            </fieldset>

            <!-- Abstract -->
            <div class="field">
              <label for="abstract" class="field-label">
                Talk abstract <span class="required" aria-hidden="true">*</span>
              </label>
              <p class="field-hint" id="abstract-hint">
                What will attendees learn? What problem does it solve?
                Formatting: start a line with - for a bullet point, wrap words in **two asterisks** for bold, and write links as [text](https://…).
              </p>
              <textarea
                id="abstract"
                aria-describedby="abstract-hint"
                name="abstract"
                class="field-input field-textarea"
                placeholder="A short description of your talk. 2 to 4 sentences is ideal."
                rows="6"
                required
              ></textarea>
            </div>

            <!-- Target audience -->
            <div class="field">
              <label for="audience" class="field-label">
                Target audience <span class="required" aria-hidden="true">*</span>
              </label>
              <p class="field-hint">Who will get the most out of this talk? What level of experience should they have?</p>
              <textarea
                id="audience"
                name="audience"
                class="field-input field-textarea"
                placeholder="e.g. Developers curious about AI, no prior ML experience needed. Or: backend engineers familiar with distributed systems."
                rows="3"
                required
              ></textarea>
            </div>

            <!-- Bio -->
            <div class="field">
              <label for="bio" class="field-label">
                Speaker bio <span class="required" aria-hidden="true">*</span>
              </label>
              <p class="field-hint">A few sentences about you and your background.</p>
              <textarea
                id="bio"
                name="bio"
                class="field-input field-textarea"
                placeholder="I'm a software engineer at … with experience in …"
                rows="3"
                required
              ></textarea>
            </div>

            <!-- Experience -->
            <div class="field">
              <label for="experience" class="field-label">
                Speaking experience
                <span class="field-optional">(optional)</span>
              </label>
              <textarea
                id="experience"
                name="experience"
                class="field-input field-textarea"
                placeholder="Have you spoken at meetups or conferences before? Doesn't matter if not. First-time speakers are very welcome."
                rows="3"
              ></textarea>
            </div>

            <!-- Anything else -->
            <div class="field">
              <label for="notes" class="field-label">
                Anything else?
                <span class="field-optional">(optional)</span>
              </label>
              <textarea
                id="notes"
                name="notes"
                class="field-input field-textarea"
                placeholder="Preferred dates, AV requirements, co-presenter, etc."
                rows="3"
              ></textarea>
            </div>

            <div class="form-footer">
              <p class="form-note">
                <span class="required" aria-hidden="true">*</span> Required fields.
                We'll get back to you within a week.{' '}
                <a href="/privacy" class="form-note-link">How we use your details</a>
              </p>
              <button type="submit" class="btn btn-primary btn-submit" id="submit-btn">
                Send my proposal
                <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>

          </form>

          <div class="form-success" id="form-success" hidden aria-live="polite">
            <div class="success-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28">
                <path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="success-title">Proposal received</h3>
            <p class="success-body">Thanks for putting your hand up. We'll be in touch within a week.</p>
            <p class="success-body">
              Follow it, or make changes until we've decided, in the <a href={PORTAL_SIGN_IN_URL} class="form-note-link">speaker portal</a>. Sign in with the email you used.
            </p>
          </div>

          <div class="form-error" id="form-error" hidden aria-live="polite">
            <p class="error-text"><span id="form-error-message">Something went wrong.</span> Please try again or email us at <a href="mailto:hello@gdgsydney.com" class="coc-link">hello@gdgsydney.com</a>.</p>
          </div>

        </section>

      </div>
    </div>
  </div>

  <script>
    // Proposals go to the back office's /api/submit-meetup-proposal (app.gdgsydney.com), which validates them,
    // saves them to Firestore (meetupProposals) and emails a confirmation, bcc'd to
    // hello@gdgsydney.com.
    const PROPOSAL_URL = import.meta.env.PUBLIC_MEETUP_PROPOSAL_URL;

    const form = document.getElementById('speaker-form') as HTMLFormElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successEl = document.getElementById('form-success') as HTMLElement;
    const errorEl = document.getElementById('form-error') as HTMLElement;
    const errorMessage = document.getElementById('form-error-message') as HTMLElement;
    const buttonContent = btn.innerHTML;

    const showError = (message: string) => {
      errorMessage.textContent = message;
      errorEl.hidden = false;
      btn.disabled = false;
      btn.innerHTML = buttonContent;
    };

    // Sends whatever is in the form, for both the submit button and the agent tool below.
    // Resolves to null on success, or the message shown to the person on failure.
    const sendProposal = async (): Promise<string | null> => {
      btn.disabled = true;
      btn.textContent = 'Sending…';
      errorEl.hidden = true;

      const data = new FormData(form);
      const field = (name: string) => String(data.get(name) ?? '').trim();
      const payload = {
        name: field('name'),
        email: field('email'),
        profileUrl: field('profile'),
        talkTitle: field('title'),
        format: field('format'),
        abstract: field('abstract'),
        audience: field('audience'),
        bio: field('bio'),
        speakingExperience: field('experience'),
        notes: field('notes'),
        companyWebsite: field('companyWebsite'),
      };

      try {
        const response = await fetch(PROPOSAL_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) {
          const body = await response.json().catch(() => null);
          const message = body?.message ?? 'Something went wrong.';
          showError(message);
          return message;
        }
        form.hidden = true;
        successEl.hidden = false;
        return null;
      } catch {
        const message = "We couldn't reach the server.";
        showError(message);
        return message;
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      await sendProposal();
    });

    // WebMCP (navigator.modelContext): lets an AI agent in the person's browser submit a
    // proposal as a structured tool call instead of clicking through the form. An early
    // web standard, so this does nothing where the browser doesn't offer it. The tool fills
    // in the visible form before sending, so the person sees exactly what went, and the
    // page then shows the usual success or error message. Agents without a browser use the
    // same endpoint directly; both are described in /llms.txt.
    type ProposalInput = {
      name: string;
      email: string;
      profileUrl?: string;
      talkTitle: string;
      format: 'standard' | 'workshop';
      abstract: string;
      audience: string;
      bio: string;
      speakingExperience?: string;
      notes?: string;
    };
    type ModelContext = {
      registerTool: (tool: {
        name: string;
        description: string;
        inputSchema: object;
        execute: (input: ProposalInput) => Promise<{ content: { type: 'text'; text: string }[] }>;
      }) => unknown;
    };
    const modelContext = (navigator as Navigator & { modelContext?: ModelContext }).modelContext;

    if (modelContext && typeof modelContext.registerTool === 'function') {
      const setField = (name: string, value: string | undefined) => {
        const input = form.elements.namedItem(name);
        if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) input.value = value ?? '';
      };
      const reply = (text: string) => ({ content: [{ type: 'text' as const, text }] });

      try {
        modelContext.registerTool({
          name: 'submit_talk_proposal',
          description:
            'Submit a talk or workshop proposal for a GDG Sydney monthly meetup on behalf of the person using this browser. ' +
            'Only call this after the person has read and approved every field, and use their own name and email: the ' +
            'confirmation email goes to that address, and organisers reply to it within a week. Write in their voice. ' +
            'Abstract formatting: lines starting with "- " are bullets, **text** is bold, [text](https://...) is a link.',
          inputSchema: {
            type: 'object',
            properties: {
              name: { type: 'string', description: "The speaker's full name.", maxLength: 200 },
              email: { type: 'string', format: 'email', description: "The speaker's email address." },
              profileUrl: { type: 'string', description: 'Optional LinkedIn or personal website URL.' },
              talkTitle: { type: 'string', description: 'The talk title.' },
              format: {
                type: 'string',
                enum: ['standard', 'workshop'],
                description: 'standard: a 20 to 30 minute talk. workshop: a 60 to 90 minute hands-on session.',
              },
              abstract: { type: 'string', description: 'What attendees will learn and what problem it solves. 2 to 4 sentences is ideal.' },
              audience: { type: 'string', description: 'Who will get the most out of it, and what experience they need.' },
              bio: { type: 'string', description: 'A few sentences about the speaker and their background.' },
              speakingExperience: { type: 'string', description: 'Optional. Past talks; first-time speakers are welcome.' },
              notes: { type: 'string', description: 'Optional. Preferred dates, AV needs, a co-presenter.' },
            },
            required: ['name', 'email', 'talkTitle', 'format', 'abstract', 'audience', 'bio'],
          },
          execute: async (input) => {
            if (form.hidden) return reply('A proposal was already sent from this page. Reload it to send another.');
            setField('name', input.name);
            setField('email', input.email);
            setField('profile', input.profileUrl);
            setField('title', input.talkTitle);
            setField('abstract', input.abstract);
            setField('audience', input.audience);
            setField('bio', input.bio);
            setField('experience', input.speakingExperience);
            setField('notes', input.notes);
            const formatRadio = form.querySelector<HTMLInputElement>(`input[name="format"][value="${input.format}"]`);
            if (formatRadio) formatRadio.checked = true;

            if (!form.checkValidity()) {
              form.reportValidity();
              const invalid = Array.from(form.elements).find(
                (element): element is HTMLInputElement | HTMLTextAreaElement =>
                  (element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement) && !element.validity.valid
              );
              return reply(`Not sent: the ${invalid?.name ?? 'form'} field is missing or invalid. ${invalid?.validationMessage ?? ''}`.trim());
            }
            const error = await sendProposal();
            return reply(
              error
                ? `Not sent: ${error}`
                : "Sent. A confirmation email is on its way to the speaker's address, and organisers reply within a week. " +
                    'They can follow or edit the proposal at https://app.gdgsydney.com/speaker/sign-in.'
            );
          },
        });
      } catch {
        // A browser with a different version of the API: leave the form as it is.
      }
    }
  </script>
</SiteLayout>

<style is:global>
  /* ─── Speak masthead ────────────────────────────────────────────────── */
  .speak-masthead {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    min-height: var(--hero-h);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Background photo, darkened so the type reads first (see --hero-photo-filter). */
  .speak-masthead-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: var(--hero-photo-filter);
  }

  /* Heavier at the top (behind the transparent header), the left and the bottom where
     the text sits; clearer on the right so the speaker shows. */
  .speak-masthead-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 20, 20, 0.7) 0, rgba(20, 20, 20, 0) 180px),
      linear-gradient(90deg, rgba(20, 20, 20, 0.85) 0%, rgba(20, 20, 20, 0.45) 50%, rgba(20, 20, 20, 0.1) 100%),
      linear-gradient(0deg, rgba(20, 20, 20, 0.85) 0%, rgba(20, 20, 20, 0) 55%);
  }

  .speak-masthead .container { position: relative; width: 100%; }

  @media (max-width: 700px) {
    .speak-masthead-scrim { background: linear-gradient(0deg, rgba(20, 20, 20, 0.92) 15%, rgba(20, 20, 20, 0.6) 100%); }
  }

  .speak-masthead-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 700px) {
    .speak-masthead-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .speak-heading {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--fg);
    margin-bottom: 0.75rem;
  }

  .speak-subheading {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.78);
    letter-spacing: 0.04em;
  }

  .speak-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-shrink: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-value {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--fg);
    line-height: 1;
  }

  .stat-plus {
    color: var(--blue-text);
  }

  .stat-label {
    font-family: var(--sans);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.72);
  }

  .stat-divider {
    width: 1px;
    height: 2.5rem;
    background: rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  /* ─── Speak layout ──────────────────────────────────────────────────── */
  .speak-body {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .speak-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 960px) {
    .speak-layout {
      grid-template-columns: 260px 1fr;
      gap: 5rem;
      align-items: start;
    }
  }

  /* ─── Info sidebar ──────────────────────────────────────────────────── */
  .speak-info {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .speak-info {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .info-label {
    font-family: var(--sans);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--fg);
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    list-style: none;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .info-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
