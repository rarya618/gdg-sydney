---
import { Image } from 'astro:assets';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import RoomBar from '../../../components/devfest/RoomBar.astro';
import SlotCard from '../../../components/devfest/SlotCard.astro';
import {
  EVENT,
  ROOMS,
  TRACKS,
  sponsors,
  speakersByTrack,
  scheduleRows,
  formatTime,
  speakerPhoto,
  partnerLogo,
  initials,
  type SponsorTier,
} from '../../../lib/devfest2026';

const rows = scheduleRows();

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(EVENT.address)}`;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(EVENT.address)}&output=embed`;
const groups = speakersByTrack();

const TIERS: { tier: Exclude<SponsorTier, 'diamond'>; label: string }[] = [
  { tier: 'platinum', label: 'Platinum' },
  { tier: 'gold', label: 'Gold' },
  { tier: 'silver', label: 'Silver' },
  { tier: 'community', label: 'Community' },
];
const tierRows = TIERS.flatMap((t) => sponsors.filter((s) => s.tier === t.tier).map((sponsor) => ({ ...sponsor, label: t.label })));
const google = sponsors.find((s) => s.tier === 'diamond');

---

<SiteLayout
  title="DevFest Sydney 2026 | GDG Sydney"
  ogTitle="DevFest Sydney 2026"
  description={`DevFest Sydney 2026: ${EVENT.theme} ${EVENT.subtitle}. The schedule, speakers and partners from ${EVENT.dateLabel} at ${EVENT.venue}.`}
  current="devfest"
>
  <!-- ═════════════════════════════ MASTHEAD ═════════════════════════════ -->
  <section class="masthead" aria-labelledby="page-heading">
    <div class="container">
      <a href="/devfest" class="back-link">DevFest Sydney</a>
      <h1 class="page-heading" id="page-heading">DevFest Sydney 2026</h1>
      <p class="page-theme">Build, Secure, Scale. Developers and builders in the agentic era.</p>
      <p class="page-facts">Saturday 10 October 2026, {EVENT.venue}</p>
      <p class="page-note">This event has finished. Thank you to everyone who spoke, sponsored, volunteered and came along.</p>
      <nav class="jump-nav" aria-label="On this page">
        <a href="#schedule">Schedule</a>
        <a href="#speakers">Speakers</a>
        <a href="#partners">Partners</a>
        <a href="#venue">Venue</a>
      </nav>
    </div>
  </section>
  <section aria-label="The four rooms and their tracks">
    <RoomBar />
  </section>

  <!-- ═════════════════════════════ SCHEDULE ═════════════════════════════ -->
  <section class="section" id="schedule" aria-labelledby="schedule-heading">
    <div class="container">
      <h2 class="section-title" id="schedule-heading">Schedule</h2>

      <div class="schedule" role="table" aria-label="DevFest Sydney 2026 schedule">
        <div class="sched-head" role="row">
          <span class="sched-time-head" role="columnheader">Time</span>
          <div class="sched-rooms" role="presentation"><RoomBar variant="compact" /></div>
        </div>

        {rows.map((row) => (
          <div class="sched-row" role="row">
            <span class="sched-time" role="rowheader">{formatTime(row.startTime)}</span>
            {row.full ? (
              <div role="cell" class="sched-full">
                <SlotCard slot={row.full} />
              </div>
            ) : (
              ROOMS.map((room) => (
                <div role="cell" class="sched-col">
                  {row.columns[room].map((slot) => <SlotCard slot={slot} />)}
                </div>
              ))
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════ SPEAKERS ═════════════════════════════ -->
  <section class="section" id="speakers" aria-labelledby="speakers-heading">
    <div class="container">
      <h2 class="section-title" id="speakers-heading">Speakers</h2>
      {groups.map((group) => (
        <div class="speaker-group" style={`--track-color: ${TRACKS[group.track].color}`}>
          <h3 class="group-title">{TRACKS[group.track].label}</h3>
          <ul class="speaker-grid" role="list">
            {group.speakers.map((speaker) => {
              const photo = speakerPhoto(speaker.slug);
              return (
                <li>
                  <a href={`/devfest/2026/speakers/${speaker.slug}`} class="speaker-card">
                    {photo ? (
                      <Image src={photo} alt="" width={240} height={240} class="speaker-photo" />
                    ) : (
                      <span class="speaker-photo speaker-initials" aria-hidden="true">{initials(speaker.name)}</span>
                    )}
                    <span class="speaker-name">{speaker.name}</span>
                    {speaker.tagline && <span class="speaker-tagline">{speaker.tagline}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ═════════════════════════════ PARTNERS ═════════════════════════════ -->
  <section class="section" id="partners" aria-labelledby="partners-heading">
    <div class="container">
      <h2 class="section-title" id="partners-heading">Partners</h2>

      <div class="headline-partners">
        {google && (
          <a href={google.website} target="_blank" rel="noopener noreferrer" class="headline-partner">
            <span class="partner-role">Presented by</span>
            <Image src={partnerLogo('google')} alt="Google" class="headline-logo" height={64} />
            <p>Google backed DevFest Sydney with an event grant and support across Gemini, Google Cloud and Firebase.</p>
          </a>
        )}
        <a href="https://www.torrens.edu.au" target="_blank" rel="noopener noreferrer" class="headline-partner">
          <span class="partner-role">Venue partner</span>
          <Image src={partnerLogo('torrens')} alt="Torrens University Australia" class="headline-logo" height={64} />
          <p>Torrens University hosted the day at its Surry Hills campus, minutes from Central Station.</p>
        </a>
      </div>

      <ul class="tier-list" role="list">
        {tierRows.map((sponsor) => (
          <li class="tier-row">
            <span class="tier-label">{sponsor.label}</span>
            <a href={sponsor.website} target="_blank" rel="noopener noreferrer" class="tier-logo-link">
              <Image src={partnerLogo(sponsor.id)} alt={sponsor.name} class:list={['tier-logo', { 'tier-logo--stacked': partnerLogo(sponsor.id).width / partnerLogo(sponsor.id).height < 2.5 }]} height={72} />
            </a>
            <p class="tier-text">{sponsor.description ?? ''}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════ VENUE ═══════════════════════════════ -->
  <section class="section" id="venue" aria-labelledby="venue-heading">
    <div class="container venue">
      <div class="venue-copy">
        <h2 class="section-title" id="venue-heading">Venue</h2>
        <p class="venue-name">Torrens University, Surry Hills</p>
        <address class="venue-address">{EVENT.address}</address>
        <p class="venue-text">
          The day ran across the auditorium and breakout rooms of Torrens University's Surry Hills
          campus, with a Builder's Space for hands-on building between sessions. It's a short walk
          from Central Station.
        </p>
        <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg">
          Get directions
        </a>
      </div>
      <div class="venue-map">
        <iframe
          src={mapEmbedUrl}
          title="Map showing Torrens University, Surry Hills"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════ NEXT ═══════════════════════════════ -->
  <section class="section next" aria-labelledby="next-heading">
    <div class="container">
      <div class="next-inner">
        <h2 class="next-title" id="next-heading">DevFest Sydney 2027 hasn't been announced yet.</h2>
        <a href="https://gdg.community.dev/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
          Join to hear first
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  :focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }

  /* ─── Masthead ──────────────────────────────────────────────────────── */
  .masthead {
    background: var(--ink);
    color: white;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vw, 4.5rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
    margin-bottom: 2rem;
  }
  .back-link:hover { color: white; }

  .page-heading {
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.055em;
    max-width: 10ch;
    margin-bottom: 1.75rem;
  }

  .page-theme {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 32em;
  }

  .page-facts { margin-top: 0.5rem; font-size: 1rem; color: rgba(255, 255, 255, 0.78); }

  .page-note {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.62);
    max-width: 52ch;
  }

  .jump-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.25rem; }

  .jump-nav a {
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    text-decoration: none;
    padding: 0.55em 1.2em;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 100px;
  }
  .jump-nav a:hover { background: var(--fg); color: var(--on-accent); }

  /* ─── Schedule ──────────────────────────────────────────────────────── */
  .schedule { display: flex; flex-direction: column; gap: 0.6rem; }

  .sched-head { display: none; }

  .sched-row { display: grid; gap: 0.6rem; }

  .sched-time {
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--fg);
  }

  .sched-col { display: flex; flex-direction: column; gap: 0.6rem; }
  .sched-col:empty { display: none; }
  .sched-col > :global(.slot) { flex: 1; }
  /* A row holding a stack of short talks: don't inflate the single sessions beside it. */
  .sched-row:has(:global(.slot + .slot)) .sched-col > :global(.slot) { flex: 0 0 auto; }

  @media (max-width: 899px) {
    .sched-time { display: none; }
  }

  @media (min-width: 900px) {
    .sched-head,
    .sched-row {
      display: grid;
      grid-template-columns: 76px repeat(4, minmax(0, 1fr));
      gap: 0.6rem;
    }

    .sched-head {
      position: sticky;
      top: var(--header-h);
      z-index: 2;
      background: var(--bg);
      padding-block: 0.6rem;
      align-items: center;
    }

    .sched-rooms { grid-column: 2 / -1; }

    .sched-time-head { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }

    .sched-full { grid-column: 2 / -1; }
    .sched-col:empty { display: block; }

    .sched-time { padding-top: 1rem; }
    .sched-row:has(:global(.slot--break)) .sched-time { padding-top: 0.6rem; }
  }

  /* ─── Speakers ──────────────────────────────────────────────────────── */
  .speaker-group + .speaker-group { margin-top: 3rem; }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 1.25rem;
  }
  .group-title::before {
    content: '';
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--track-color);
  }

  .speaker-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
    gap: 1.25rem;
  }

  .speaker-card { display: flex; flex-direction: column; gap: 0.3rem; text-decoration: none; color: inherit; }

  .speaker-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 14px;
    background: var(--surface-2);
    border-bottom: 5px solid var(--track-color);
    margin-bottom: 0.5rem;
  }

  .speaker-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    color: var(--fg);
  }

  .speaker-name { font-size: 1rem; font-weight: 700; letter-spacing: -0.015em; color: var(--fg); }
  .speaker-card:hover .speaker-name { text-decoration: underline; text-underline-offset: 3px; }

  .speaker-tagline { font-size: 0.82rem; line-height: 1.5; color: var(--muted); }

  /* ─── Partners ──────────────────────────────────────────────────────── */
  .headline-partners {
    display: grid;
    background: var(--surface);
    color: white;
    border-radius: 16px;
    overflow: hidden;
  }

  @media (min-width: 800px) {
    .headline-partners { grid-template-columns: 1fr 1fr; }
    .headline-partner + .headline-partner { border-left: 1px solid rgba(255, 255, 255, 0.14); }
  }

  .headline-partner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    color: inherit;
    text-decoration: none;
  }
  .headline-partner + .headline-partner { border-top: 1px solid rgba(255, 255, 255, 0.14); }
  @media (min-width: 800px) { .headline-partner + .headline-partner { border-top: none; } }

  .partner-role { font-size: 0.9rem; color: rgba(255, 255, 255, 0.65); }

  /* Logos are shown as white silhouettes, as on the old dark site; the source files mix
     colour and white wordmarks, so flattening them is the only consistent option. */
  .headline-logo {
    height: 56px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0) invert(1);
  }

  .headline-partner p { font-size: 0.95rem; line-height: 1.65; color: rgba(255, 255, 255, 0.75); max-width: 44ch; }

  .tier-list { list-style: none; margin-top: 2.5rem; border-top: 2px solid var(--fg); }

  .tier-row {
    display: grid;
    gap: 0.75rem 2.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    align-items: center;
  }

  @media (min-width: 800px) {
    .tier-row { grid-template-columns: 8rem 13rem 1fr; }
  }

  .tier-label { font-size: 0.95rem; font-weight: 700; color: var(--fg); }

  .tier-logo-link { display: block; width: fit-content; }

  .tier-logo {
    height: 44px;
    width: auto;
    max-width: 190px;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* Stacked lockups read small at a wordmark's height. */
  .tier-logo--stacked { height: 64px; }

  .tier-text { font-size: 0.925rem; line-height: 1.65; color: var(--text-soft); max-width: 62ch; }

  /* ─── Venue ─────────────────────────────────────────────────────────── */
  .venue { display: grid; gap: 2.5rem; align-items: center; }

  @media (min-width: 900px) {
    .venue { grid-template-columns: 1fr 1.1fr; gap: 4rem; }
  }

  .venue-name {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--fg);
  }

  .venue-address {
    font-style: normal;
    font-size: 1.05rem;
    color: var(--fg);
    margin-top: 0.35rem;
  }

  .venue-text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 46ch;
    margin: 1.25rem 0 2rem;
  }

  .venue-map {
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface-2);
  }

  .venue-map iframe { width: 100%; height: 100%; border: 0; display: block; }

  /* ─── Next ──────────────────────────────────────────────────────────── */
  .section.next { border-top: none; padding-top: 0; }

  .next-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    border-top: 2px solid var(--fg);
    padding-top: 2.5rem;
  }

  .next-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--fg);
    max-width: 20ch;
  }
</style>
