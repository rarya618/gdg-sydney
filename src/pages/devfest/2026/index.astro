---
import { Image } from 'astro:assets';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import RoomBar from '../../../components/devfest/RoomBar.astro';
import SlotCard from '../../../components/devfest/SlotCard.astro';
import SectionRail from '../../../components/devfest/SectionRail.astro';
import {
  EVENT,
  ROOMS,
  TRACKS,
  sponsors,
  showcase,
  speakers,
  speakersByTrack,
  schedule,
  spansAllRooms,
  type Slot,
  formatTime,
  speakerPhoto,
  partnerLogo,
  initials,
  type SponsorTier,
} from '../../../lib/devfest2026';
import heroPhoto from '../../../assets/devfest/2026/photos/foyer-overhead.jpg';
import teamPhoto from '../../../assets/devfest/2026/photos/team.jpg';
import foyerPhoto from '../../../assets/devfest/2026/photos/foyer.jpg';
import workshopPhoto from '../../../assets/devfest/2026/photos/workshop.jpg';
import speakerPhotoOnStage from '../../../assets/devfest/2026/photos/speaker.jpg';
import podcastPhoto from '../../../assets/devfest/2026/photos/podcast.jpg';

// The schedule is a time grid: 5-minute rows, so a slot's height is its length.
const STEP_MINUTES = 5;
const minutes = (iso: string) => Date.parse(iso) / 60_000;
const dayStart = Math.min(...schedule.map((slot) => minutes(slot.startTime)));
const dayEnd = Math.max(...schedule.map((slot) => minutes(slot.endTime)));
const totalRows = (dayEnd - dayStart) / STEP_MINUTES;
const gridRow = (iso: string) => (minutes(iso) - dayStart) / STEP_MINUTES + 1;

// DOM order is time order (then room order), which is also the reading order on mobile.
const roomOrder = (slot: Slot) => (spansAllRooms(slot) ? -1 : ROOMS.indexOf(slot.room as (typeof ROOMS)[number]));
const timeline = [...schedule]
  .sort((a, b) => minutes(a.startTime) - minutes(b.startTime) || roomOrder(a) - roomOrder(b))
  .map((slot) => ({
    slot,
    style: `grid-row: ${gridRow(slot.startTime)} / ${gridRow(slot.endTime)}; grid-column: ${spansAllRooms(slot) ? '2 / -1' : roomOrder(slot) + 2};`,
    short: minutes(slot.endTime) - minutes(slot.startTime) < 20 && !spansAllRooms(slot),
  }));
const timeLabels = [...new Set(schedule.map((slot) => slot.startTime))].map((iso) => ({ iso, row: gridRow(iso) }));

// From the closing slides. Last year's DevFest sold 150 tickets.
const recapStats = [
  { value: '280+', label: 'attendees, double last year' },
  { value: String(speakers.length), label: 'speakers' },
  { value: '4', label: 'tracks' },
  { value: String(showcase.length), label: 'projects in the Builder Showcase' },
];

// The first photo leads the grid at double size.
const recapPhotos = [
  { src: teamPhoto, alt: 'The DevFest Sydney 2026 volunteers and organisers on stage' },
  { src: foyerPhoto, alt: 'Attendees filling the foyer between sessions' },
  { src: workshopPhoto, alt: 'A full workshop room, attendees working on laptops' },
  { src: speakerPhotoOnStage, alt: 'A speaker on the main stage', position: 'center 15%' },
  { src: podcastPhoto, alt: 'A speaker recording an interview in the podcast booth' },
];

// The page's sections, for the jump links in the masthead and the rail once they've scrolled
// away. The rail's labels are short, to fit the page margin.
const pageSections = [
  { id: 'recap', label: 'Recap' },
  { id: 'schedule', label: 'Schedule' },
  { id: 'speakers', label: 'Speakers' },
  { id: 'showcase', label: 'Showcase', fullLabel: 'Builder Showcase' },
  { id: 'partners', label: 'Partners' },
  { id: 'venue', label: 'Venue' },
];

const showcaseSlot = schedule.find((slot) => slot.title === 'Builder Showcase');
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(EVENT.address)}`;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(EVENT.address)}&output=embed`;
const groups = speakersByTrack();

// One sponsor wall, sized by tier: the headline partners and Gold/Silver share a row,
// Platinum gets a full-width card, Community a small logo tile.
const TIER_LAYOUT: Record<Exclude<SponsorTier, 'diamond'>, { label: string; size: 'full' | 'half' | 'small' }> = {
  platinum: { label: 'Platinum', size: 'full' },
  gold: { label: 'Gold', size: 'half' },
  silver: { label: 'Silver', size: 'half' },
  community: { label: 'Community', size: 'small' },
};
const google = sponsors.find((s) => s.tier === 'diamond');
const wall = [
  ...(google
    ? [{ id: 'google', name: 'Google', website: google.website, role: 'Presented by', size: 'half' as const,
        description: 'Google backed DevFest Sydney with an event grant and support across Gemini, Google Cloud and Firebase.' }]
    : []),
  { id: 'torrens', name: 'Torrens University Australia', website: 'https://www.torrens.edu.au', role: 'Venue partner', size: 'half' as const,
    description: 'Torrens University hosted the day at its Surry Hills campus, minutes from Central Station.' },
  ...(['platinum', 'gold', 'silver', 'community'] as const).flatMap((tier) =>
    sponsors
      .filter((s) => s.tier === tier)
      .map((s) => ({ id: s.id, name: s.name, website: s.website, role: TIER_LAYOUT[tier].label, size: TIER_LAYOUT[tier].size, description: s.description }))
  ),
];

---

<SiteLayout
  title="DevFest Sydney 2026 | GDG Sydney"
  ogTitle="DevFest Sydney 2026"
  description={`DevFest Sydney 2026: ${EVENT.theme} ${EVENT.subtitle}. The schedule, speakers, Builder Showcase and partners from ${EVENT.dateLabel} at ${EVENT.venue}.`}
  current="devfest"
>
  <!-- ═════════════════════════════ MASTHEAD ═════════════════════════════ -->
  <section class="masthead" aria-labelledby="page-heading" data-hero>
    <Image
      src={heroPhoto}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      class="masthead-photo"
      loading="eager"
      fetchpriority="high"
    />
    <div class="masthead-scrim" aria-hidden="true"></div>
    <div class="container">
      <a href="/devfest" class="back-link">DevFest Sydney</a>
      <h1 class="page-heading" id="page-heading">DevFest Sydney 2026</h1>
      <p class="page-theme">Build, Secure, Scale. Developers and builders in the agentic era.</p>
      <p class="page-facts">Saturday 10 October 2026, {EVENT.venue}</p>
      <p class="page-note">This event has finished. Thank you to everyone who spoke, sponsored, volunteered and came along.</p>
      <nav class="jump-nav" aria-label="On this page">
        {pageSections.map((section) => (
          <a href={`#${section.id}`}>{section.fullLabel ?? section.label}</a>
        ))}
      </nav>
    </div>
  </section>
  <SectionRail sections={pageSections} />

  <!-- ══════════════════════════════ RECAP ═══════════════════════════════ -->
  <section class="section recap" id="recap" aria-labelledby="recap-heading">
    <div class="container">
      <h2 class="section-title" id="recap-heading">How the day went</h2>
      <dl class="recap-stats">
        {recapStats.map((stat) => (
          <div class="recap-stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
      <ul class="recap-photos" role="list" aria-label="Photos from DevFest Sydney 2026">
        {recapPhotos.map((photo, i) => (
          <li class:list={['recap-photo', { 'recap-photo-lead': i === 0 }]}>
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={i === 0 ? [700, 1100, 1440] : [400, 700]}
              sizes={i === 0 ? '(min-width: 800px) 50vw, 100vw' : '(min-width: 800px) 25vw, 50vw'}
              style={photo.position ? `object-position: ${photo.position}` : undefined}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="rooms" aria-label="The four rooms and their tracks">
    <div class="container">
      <RoomBar />
    </div>
  </section>

  <!-- ═════════════════════════════ SCHEDULE ═════════════════════════════ -->
  <section class="section" id="schedule" aria-labelledby="schedule-heading">
    <div class="container">
      <h2 class="section-title" id="schedule-heading">Schedule</h2>

      <div class="sched-head" aria-hidden="true">
        <span class="sched-time-head">Time</span>
        <div class="sched-rooms"><RoomBar variant="compact" /></div>
      </div>

      <ol class="timeline" style={`--rows: ${totalRows}`} aria-label="DevFest Sydney 2026 schedule, in time order">
        {timeLabels.map((label) => (
          <li class="timeline-time" style={`grid-row: ${label.row}`} aria-hidden="true">{formatTime(label.iso)}</li>
        ))}
        {timeline.map((item) => (
          <li class="timeline-slot" style={item.style}>
            <SlotCard slot={item.slot} short={item.short} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═════════════════════════════ SPEAKERS ═════════════════════════════ -->
  <section class="section" id="speakers" aria-labelledby="speakers-heading">
    <div class="container">
      <h2 class="section-title" id="speakers-heading">Speakers</h2>
      {groups.map((group) => (
        <div class="speaker-group" style={`--track-color: ${TRACKS[group.track].color}`}>
          <h3 class="group-title">{TRACKS[group.track].label}</h3>
          <ul class="speaker-grid" role="list">
            {group.speakers.map((speaker) => {
              const photo = speakerPhoto(speaker.slug);
              return (
                <li>
                  <a href={`/devfest/2026/speakers/${speaker.slug}`} class="speaker-card">
                    {photo ? (
                      <Image src={photo} alt="" width={240} height={240} class="speaker-photo" />
                    ) : (
                      <span class="speaker-photo speaker-initials" aria-hidden="true">{initials(speaker.name)}</span>
                    )}
                    <span class="speaker-name">{speaker.name}</span>
                    {speaker.tagline && <span class="speaker-tagline">{speaker.tagline}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════ BUILDER SHOWCASE ══════════════════════════ -->
  <section class="section" id="showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <h2 class="section-title" id="showcase-heading">Builder Showcase</h2>
      <p class="showcase-intro">
        {showcase.length} projects from the community took the main stage
        {showcaseSlot ? ` at ${formatTime(showcaseSlot.startTime)}` : ''}, with five minutes each:
        four minutes of demo and one of questions.
      </p>
      <ul class="showcase-grid" role="list">
        {showcase.map((entry) => (
          <li class="showcase-card">
            <h3 class="showcase-project">{entry.project}</h3>
            <p class="showcase-presenters">{entry.presenters.join(' and ')}</p>
            <p class="showcase-pitch">{entry.pitch}</p>
            {entry.url && (
              <a
                href={entry.url}
                target="_blank"
                rel="noopener noreferrer"
                class="showcase-link"
                aria-label={`${entry.project}: ${hostOf(entry.url)} (opens in a new tab)`}
              >
                {hostOf(entry.url)}
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════════════════════════ PARTNERS ═════════════════════════════ -->
  <section class="section" id="partners" aria-labelledby="partners-heading">
    <div class="container">
      <h2 class="section-title" id="partners-heading">Partners</h2>

      <ul class="wall" role="list">
        {wall.map((partner) => {
          const logo = partnerLogo(partner.id);
          const stacked = logo.width / logo.height < 2.5;
          return (
            <li class:list={['wall-card', `wall-card--${partner.size}`]}>
              <a href={partner.website} target="_blank" rel="noopener noreferrer" class="wall-link">
                <span class="wall-role">{partner.role}</span>
                <span class="wall-logo-box">
                  <Image src={logo} alt={partner.name} class:list={['wall-logo', { 'wall-logo--stacked': stacked }]} height={96} />
                </span>
                {partner.description && partner.size !== 'small' && <p class="wall-text">{partner.description}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════ VENUE ═══════════════════════════════ -->
  <section class="section" id="venue" aria-labelledby="venue-heading">
    <div class="container venue">
      <div class="venue-copy">
        <h2 class="section-title" id="venue-heading">Venue</h2>
        <p class="venue-name">Torrens University, Surry Hills</p>
        <address class="venue-address">{EVENT.address}</address>
        <p class="venue-text">
          The day ran across the auditorium and breakout rooms of Torrens University's Surry Hills
          campus, with a Builder's Space for hands-on building between sessions. It's a short walk
          from Central Station.
        </p>
        <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg">
          Get directions
        </a>
      </div>
      <div class="venue-map">
        <iframe
          src={mapEmbedUrl}
          title="Map showing Torrens University, Surry Hills"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════ NEXT ═══════════════════════════════ -->
  <section class="section next" aria-labelledby="next-heading">
    <div class="container">
      <div class="next-inner">
        <h2 class="next-title" id="next-heading">DevFest Sydney 2027 hasn't been announced yet.</h2>
        <a href="https://gdg.community.dev/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
          Join to hear first
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>

  /* ─── Masthead ──────────────────────────────────────────────────────── */
  .masthead {
    background: var(--ink);
    color: white;
    min-height: var(--hero-h);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: 2rem;
  }
  .masthead { position: relative; overflow: hidden; }
  .masthead .container { position: relative; width: 100%; }

  /* The foyer from above at DevFest 2026, cropped to the crowd. */
  .masthead-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 68%;
    filter: var(--hero-photo-filter);
  }

  /* Heavy on the left and bottom where the type sits, lighter on the right so the crowd shows. */
  .masthead-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 20, 20, 0.7) 0, rgba(20, 20, 20, 0) 180px),
      linear-gradient(90deg, rgba(20, 20, 20, 0.94) 0%, rgba(20, 20, 20, 0.8) 42%, rgba(20, 20, 20, 0.25) 75%, rgba(20, 20, 20, 0.1) 100%),
      linear-gradient(0deg, rgba(20, 20, 20, 0.85) 0%, rgba(20, 20, 20, 0) 50%);
  }

  @media (max-width: 700px) {
    .masthead-scrim { background: linear-gradient(0deg, rgba(20, 20, 20, 0.95) 10%, rgba(20, 20, 20, 0.6) 80%, rgba(20, 20, 20, 0.75) 100%); }
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
    margin-bottom: 1.25rem;
  }
  .back-link:hover { color: white; }

  .page-heading {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.055em;
    max-width: 10ch;
    margin-bottom: 1.25rem;
  }

  .page-theme {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 32em;
  }

  .page-facts { margin-top: 0.5rem; font-size: 1rem; color: rgba(255, 255, 255, 0.78); }

  .page-note {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.62);
    max-width: 52ch;
  }

  .jump-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }

  @media (max-width: 700px) {
    .page-note { margin-top: 1rem; }
  }

  .jump-nav a {
    font-size: 0.875rem;
    font-weight: 700;
    color: white;
    text-decoration: none;
    padding: 0.55em 1.2em;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 100px;
  }
  .jump-nav a:hover { background: var(--fg); color: var(--on-accent); }

  /* ─── Recap: numbers, then a photo grid led by the team photo ──────── */
  .recap-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 800px) {
    .recap-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* Number above its label, while the label stays first for screen readers. */
  .recap-stat { display: flex; flex-direction: column-reverse; gap: 0.35rem; }

  .recap-stat dd {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--fg);
  }

  .recap-stat dt {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--text-soft);
  }

  .recap-photos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  @media (min-width: 800px) {
    .recap-photos { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .recap-photo {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-2);
  }

  .recap-photo-lead { grid-column: span 2; }

  @media (min-width: 800px) {
    .recap-photo-lead { grid-row: span 2; aspect-ratio: auto; }
  }

  .recap-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Rooms: within the page margins like everything else ──────────── */
  .recap + .rooms { border-top: 1px solid var(--border); }
  .rooms { padding-top: clamp(2.5rem, 5vw, 3.5rem); }

  /* ─── Schedule: a time grid ───────────────────────────────────────────
     Desktop places every slot by its start and end time on 5-minute rows, so heights
     are proportional to length. Mobile falls back to a plain list in time order. */
  .sched-head { display: none; }

  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .timeline-time { display: none; }

  @media (min-width: 900px) {
    .sched-head,
    .timeline {
      display: grid;
      grid-template-columns: 76px repeat(4, minmax(0, 1fr));
      column-gap: 0.6rem;
    }

    .sched-head {
      position: sticky;
      top: var(--header-h);
      z-index: 2;
      background: var(--bg);
      padding-block: 0.6rem;
      margin-bottom: 0.4rem;
      align-items: center;
    }

    .sched-rooms { grid-column: 2 / -1; }
    .sched-time-head { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }

    .timeline {
      --step: 24px; /* height of 5 minutes: 4.8px per minute */
      grid-template-rows: repeat(var(--rows), var(--step));
      row-gap: 0;
      /* Faint line every half hour, so time reads across the columns. */
      background-image: repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.07) 0 1px,
        transparent 1px calc(var(--step) * 6)
      );
      background-position: 76px 0;
      background-repeat: repeat-y;
    }

    .timeline-time {
      display: block;
      grid-column: 1;
      font-family: var(--mono);
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--fg);
      padding-top: 0.35rem;
    }

    /* A small inset so neighbouring slots never touch; heights stay proportional. */
    .timeline-slot { padding: 3px 0; min-height: 0; }
    .timeline-slot > :global(.slot) { height: 100%; }
    /* On top of the page's scroll padding, clear the sticky room headings too. */
    .timeline-slot :global(a) { scroll-margin-top: 4.5rem; }
  }

  /* ─── Speakers ──────────────────────────────────────────────────────── */
  .speaker-group + .speaker-group { margin-top: 3rem; }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 1.25rem;
  }
  .group-title::before {
    content: '';
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--track-color);
  }

  .speaker-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
    gap: 1.25rem;
  }

  .speaker-card { display: flex; flex-direction: column; gap: 0.3rem; text-decoration: none; color: inherit; }

  .speaker-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    /* Circles with a track-colour ring, matching the faces on /devfest. */
    border-radius: 50%;
    background: var(--surface-2);
    border: 3px solid var(--track-color);
    margin-bottom: 0.5rem;
  }

  .speaker-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    color: var(--fg);
  }

  .speaker-name { font-size: 1rem; font-weight: 700; letter-spacing: -0.015em; color: var(--fg); }
  .speaker-name { transition: color 0.15s ease; }
  .speaker-card:hover .speaker-name { color: var(--blue-text); }

  .speaker-tagline { font-size: 0.82rem; line-height: 1.5; color: var(--muted); }

  /* ─── Builder Showcase ──────────────────────────────────────────────── */
  .showcase-intro {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .showcase-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }

  /* Yellow is the showcase's colour, as on the schedule and the old DevFest site. */
  .showcase-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 1.6rem);
    border: 1px solid var(--border);
    border-top: 4px solid var(--yellow);
    border-radius: 16px;
  }

