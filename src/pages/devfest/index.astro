---
import { Image, getImage } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { EVENT, speakers, speakerPhoto, TRACKS } from '../../lib/devfest2026';
// Hero photo is the original devfest.gdgsydney.com hero, kept for its resolution.
// The carousel is from DevFest 2026.
import heroPhoto from '../../assets/devfest/photos/hero.jpg';
import workshopRoomPhoto from '../../assets/devfest/2026/photos/workshop-room.jpg';
import podcastPhoto from '../../assets/devfest/2026/photos/podcast.jpg';
import speakerStagePhoto from '../../assets/devfest/2026/photos/speaker-stage.jpg';
import chattingPhoto from '../../assets/devfest/2026/photos/chatting.jpg';
import foyerGroupPhoto from '../../assets/devfest/2026/photos/foyer-group.jpg';
import workshopTalkPhoto from '../../assets/devfest/2026/photos/workshop-talk.jpg';
import foyerCrowdPhoto from '../../assets/devfest/2026/photos/foyer-crowd.jpg';
import teamPhoto from '../../assets/devfest/2026/photos/team.jpg';
import { DEVFEST_FAQ, faqStructuredData } from '../../lib/devfestFaq';

const ogImage = await getImage({ src: heroPhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

// Keynote first, then the lineup in name order. Photos only: two co-speakers have none,
// and 21 faces make an exact 3 x 7 grid.
const lineup = [...speakers]
  .sort((a, b) => Number(b.track === 'keynote') - Number(a.track === 'keynote'))
  .filter((speaker) => speaker.photoUrl);

const COMMUNITY_URL = 'https://gdg.community.dev/gdg-sydney/';

const carousel = [
  { src: workshopRoomPhoto, alt: 'A speaker presenting to a full workshop room' },
  { src: podcastPhoto, alt: 'A speaker recording an interview in the podcast booth' },
  { src: speakerStagePhoto, alt: 'A speaker on the main stage' },
  { src: chattingPhoto, alt: 'Attendees chatting over coffee between sessions' },
  { src: foyerGroupPhoto, alt: 'Four attendees posing together in the foyer' },
  { src: workshopTalkPhoto, alt: 'A speaker leading a session in a workshop room' },
  { src: foyerCrowdPhoto, alt: 'Attendees moving through the foyer between talks' },
  { src: teamPhoto, alt: 'The volunteers and organisers on stage' },
];
---

<SiteLayout
  title="DevFest Sydney | GDG Sydney"
  ogTitle="DevFest Sydney"
  description="DevFest Sydney is GDG Sydney's annual conference for developers and builders, presented by Google. See what happened at DevFest Sydney 2026 and hear first about 2027."
  ogImage={ogImage.src}
  ogImageAlt="Attendees at DevFest Sydney"
  current="devfest"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqStructuredData())} />

  <!-- ═════════════════════════════ HERO ═════════════════════════════════ -->
  <section class="hero" aria-labelledby="df-heading" data-hero>
    <Image
      src={heroPhoto}
      alt="A talk in progress at DevFest Sydney"
      widths={[800, 1400, 2000]}
      sizes="100vw"
      class="hero-photo"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 class="hero-title" id="df-heading">DevFest<br />Sydney</h1>
      <p class="hero-lede">GDG Sydney's annual conference for developers and builders, presented by Google.</p>
      <div class="hero-actions">
        <a href={COMMUNITY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
          Join to hear about 2027
        </a>
        <a href="/devfest/2026" class="hero-link">See DevFest 2026</a>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════ 2026 ═════════════════════════════════ -->
  <section class="section" aria-labelledby="recap-heading">
    <div class="container recap">
      <div class="recap-copy">
        <h2 class="recap-title" id="recap-heading">
          2026 was<br />Build, Secure, Scale.
        </h2>
        <p>
          280+ people and {speakers.length} speakers across four rooms at {EVENT.venue}, on {EVENT.dateLabel.replace('Saturday, ', 'Saturday ')}.
          That's double last year's crowd. The full schedule, every talk and the partners who made it possible are in the archive.
        </p>
        <a href="/devfest/2026" class="btn btn-dark btn-lg">Open the 2026 archive</a>
      </div>

      <ul class="lineup" role="list" aria-label="DevFest Sydney 2026 speakers">
        {lineup.map((speaker) => {
          const photo = speakerPhoto(speaker.slug);
          return (
            <li>
              <a
                href={`/devfest/2026/speakers/${speaker.slug}`}
                class="lineup-face"
                style={`--track-color: ${TRACKS[speaker.track].color}`}
                title={speaker.name}
              >
                {photo && <Image src={photo} alt={speaker.name} width={120} height={120} />}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- No autoplay: it scrolls by swipe, trackpad, arrow keys or the buttons. -->
  <section class="carousel" aria-roledescription="carousel" aria-label="Photos from DevFest Sydney 2026" data-carousel>
    <ul class="carousel-track" role="list" tabindex="0" aria-label="Photos, scroll sideways for more" data-carousel-track>
      {carousel.map((photo, i) => (
        <li class="carousel-slide" aria-roledescription="slide" aria-label={`${i + 1} of ${carousel.length}`}>
          <Image src={photo.src} alt={photo.alt} widths={[480, 800, 1100]} sizes="(min-width: 700px) 38vw, 85vw" loading="lazy" />
        </li>
      ))}
    </ul>
    <button type="button" class="carousel-btn carousel-btn-prev" aria-label="Previous photos" data-carousel-prev disabled>
      <svg viewBox="0 0 20 20" fill="currentColor" width="22" height="22" aria-hidden="true">
        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.832 10l3.938 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z" clip-rule="evenodd" />
      </svg>
    </button>
    <button type="button" class="carousel-btn carousel-btn-next" aria-label="Next photos" data-carousel-next>
      <svg viewBox="0 0 20 20" fill="currentColor" width="22" height="22" aria-hidden="true">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" />
      </svg>
    </button>
  </section>

  <script>
    // Buttons step one slide at a time and switch off at either end.
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]')!;
      const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]')!;
      const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]')!;
      const step = () => (track.firstElementChild as HTMLElement).offsetWidth;
      const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

      const update = () => {
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      };

      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  </script>

  <!-- ═══════════════════════════ GET INVOLVED ══════════════════════════ -->
  <section class="section involved" aria-labelledby="involved-heading">
    <div class="container split">
      <h2 class="section-title split-title" id="involved-heading">Help make 2027 happen</h2>
      <ul class="involved-list" role="list">
        <li class="involved-row">
          <h3>Speak</h3>
          <div>
            <p>
              The Call for Speakers opens a few months before the event. Our monthly meetups are a
              good first stage, and first-time speakers are welcome.
            </p>
            <a href="/speak">Speak at a meetup</a>
          </div>
        </li>
        <li class="involved-row">
          <h3>Sponsor</h3>
          <div>
            <p>DevFest is run by our organisers, and sponsors make the day possible. Ask us for the prospectus.</p>
            <a href="mailto:hello@gdgsydney.com?subject=Sponsoring%20DevFest%20Sydney%202027">Email about sponsoring</a>
          </div>
        </li>
        <li class="involved-row">
          <h3>Volunteer</h3>
          <div>
            <p>Volunteers keep the day running and get to know the community behind it.</p>
            <a href="mailto:hello@gdgsydney.com?subject=Volunteering%20at%20DevFest%20Sydney">Email about volunteering</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════ FAQ ════════════════════════════════ -->
  <section class="section faq" id="faq" aria-labelledby="faq-heading">
    <div class="container split">
      <div class="split-title">
        <h2 class="section-title" id="faq-heading">Common questions</h2>
        <p class="split-note">
          Something else? Email <a href="mailto:hello@gdgsydney.com">hello@gdgsydney.com</a>.
        </p>
      </div>
      <div class="faq-list">
        {DEVFEST_FAQ.map((item) => (
          <details class="faq-item" data-faq>
            <summary>{item.question}</summary>
            <p set:html={item.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Animate each answer open and closed. The rows stay native <details>, so keyboard,
    // screen readers and find-in-page all still work; this only adds the motion.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    document.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((details) => {
      const summary = details.querySelector('summary')!;
      let animation: Animation | null = null;

      const run = (from: number, to: number, onDone: () => void) => {
        animation?.cancel();
        details.style.overflow = 'hidden';
        const current = details.animate({ height: [`${from}px`, `${to}px`] }, { duration: 260, easing: 'cubic-bezier(0.2, 0, 0, 1)' });
        animation = current;
        current.onfinish = () => {
          onDone();
          if (animation === current) animation = null;
          details.style.overflow = '';
        };
      };

      summary.addEventListener('click', (event) => {
        if (reduceMotion.matches) return;
        event.preventDefault();
        const from = details.offsetHeight;
        // Mid-animation, a click reverses it; otherwise it toggles.
        const closing = animation ? details.dataset.state === 'opening' : details.open;

        // Closing: shrink to the question, then close.
        if (closing) {
          details.dataset.state = 'closing';
          run(from, summary.offsetHeight, () => { details.open = false; });
          return;
        }

        // Opening: open first so the answer can be measured.
        details.dataset.state = 'opening';
        details.open = true;
        const to = summary.offsetHeight + (details.querySelector('p')?.offsetHeight ?? 0);
        run(from, to, () => {});
      });
    });
  </script>
</SiteLayout>

<style>
  /* ─── Hero: full-bleed photo, type over a scrim ───────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: var(--hero-h);
    padding-top: var(--header-h);
    color: white;
    background: var(--ink);
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    /* Darkened so the type reads first (see --hero-photo-filter). */
    filter: var(--hero-photo-filter);
  }

  /* Heavy on the left and bottom where the type sits, clear on the right so the crowd shows. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(20, 20, 20, 0.7) 0, rgba(20, 20, 20, 0) 180px),
      linear-gradient(90deg, rgba(20, 20, 20, 0.94) 0%, rgba(20, 20, 20, 0.78) 38%, rgba(20, 20, 20, 0.2) 72%, rgba(20, 20, 20, 0.05) 100%),
      linear-gradient(0deg, rgba(20, 20, 20, 0.85) 0%, rgba(20, 20, 20, 0) 45%);
  }

  .hero-content {
    position: relative;
    width: 100%;
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.055em;
    margin-bottom: 1.5rem;
  }

  .hero-lede {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    max-width: 26em;
    margin-bottom: 2rem;
  }

  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }

  .hero-link {
    color: white;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.45);
    text-underline-offset: 4px;
  }
  .hero-link:hover { text-decoration-color: white; }

  /* On narrow screens the type covers most of the photo, so darken it evenly. */
  @media (max-width: 700px) {
    .hero-scrim { background: linear-gradient(0deg, rgba(20, 20, 20, 0.95) 10%, rgba(20, 20, 20, 0.55) 80%, rgba(20, 20, 20, 0.75) 100%); }
  }

  /* ─── Photo carousel: full-bleed, the next photo peeks in ─────────── */
  .carousel {
    position: relative;
    background: var(--ink);
  }

  .carousel-track {
    list-style: none;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-track:focus-visible { outline: 3px solid var(--blue-text); outline-offset: -3px; }

  .carousel-slide {
    flex: 0 0 85%;
    scroll-snap-align: start;
  }

  @media (min-width: 700px) {
    .carousel-slide { flex-basis: 38%; }
  }

  .carousel-slide img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.92);
    color: #1f1f1f;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    transition: opacity 0.2s ease, background 0.15s ease;
  }
  .carousel-btn:hover { background: white; }
  .carousel-btn:focus-visible { outline: 3px solid var(--blue-text); outline-offset: 3px; }
  .carousel-btn:disabled { opacity: 0; pointer-events: none; }
  .carousel-btn-prev { left: clamp(0.75rem, 2vw, 1.5rem); }
  .carousel-btn-next { right: clamp(0.75rem, 2vw, 1.5rem); }

  /* Touch screens swipe; the buttons would only cover the photos. */
  @media (hover: none) {
    .carousel-btn { display: none; }
  }

  /* ─── 2026 recap ────────────────────────────────────────────────────── */
  .recap { display: grid; gap: 3rem; align-items: center; }

  @media (min-width: 960px) {
    .recap { grid-template-columns: 1fr 1fr; gap: 5rem; }
  }

  .recap-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
    color: var(--fg);
    margin-bottom: 1.5rem;
  }

  .recap-copy p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 34em;
    margin-bottom: 2rem;
  }

  .btn-dark { background: var(--fg); color: var(--on-accent); }
  .btn-dark:hover { background: white; }

  .lineup {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: clamp(0.4rem, 1vw, 0.65rem);
  }

  .lineup-face {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface-2);
    /* A thin, half-strength ring: the track still shows, the face leads. */
    border: 1.5px solid color-mix(in srgb, var(--track-color) 55%, transparent);
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
  }

  .lineup-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* ─── Lower sections: title left, content right ─────────────────────── */
  .split { display: grid; gap: 1.5rem; }

  @media (min-width: 900px) {
    .split { grid-template-columns: 17rem minmax(0, 1fr); gap: 4rem; align-items: start; }
    .split-title { position: sticky; top: calc(var(--header-h) + 2rem); }
  }

  .split-title.section-title,
  .split-title .section-title { margin-bottom: 0; }

  .split-note { margin-top: 1rem; font-size: 0.95rem; line-height: 1.6; color: var(--text-soft); }
  .split-note a {
    color: var(--fg);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 3px;
  }
  .split-note a:hover { text-decoration-color: var(--fg); }

  /* ─── Get involved: rows, not cards ─────────────────────────────────── */
  .involved-list { list-style: none; border-top: 2px solid var(--fg); }

  .involved-row {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  @media (min-width: 640px) {
    .involved-row { grid-template-columns: 9rem minmax(0, 1fr); align-items: baseline; }
  }

  .involved-row div { display: flex; flex-direction: column; align-items: flex-start; gap: 0.85rem; }

  .involved-row h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .involved-row p { font-size: 0.975rem; line-height: 1.65; color: var(--text-soft); max-width: 52ch; }

  .involved-row a {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .involved-row a:hover { text-decoration-color: var(--fg); }
  /* ─── FAQ: native disclosure rows ───────────────────────────────────── */
  .faq-list { border-top: 2px solid var(--fg); }

  .faq-item { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.35rem;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
    /* No text selection on quick clicks and no tap flash on phones. Keyboard focus keeps its ring. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  /* The icon turns back as soon as closing starts, not when the answer has gone. */
  .faq-item[open]:not([data-state='closing']) summary::after { transform: rotate(45deg); }


  .faq-item p {
    padding-bottom: 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 64ch;
  }

  .faq-item p :global(a) {
    color: var(--fg);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 3px;
  }
  .faq-item p :global(a:hover) { text-decoration-color: var(--fg); }
</style>
