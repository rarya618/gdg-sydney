---
import { Image, getImage } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import RoomBar from '../../components/devfest/RoomBar.astro';
import { EVENT, speakers, speakerPhoto, initials, TRACKS } from '../../lib/devfest2026';
import heroPhoto from '../../assets/devfest/photos/hero.jpg';
import { DEVFEST_FAQ, faqStructuredData } from '../../lib/devfestFaq';

const ogImage = await getImage({ src: heroPhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

// Keynote first, then the lineup in name order.
const lineup = [...speakers].sort((a, b) => Number(b.track === 'keynote') - Number(a.track === 'keynote'));

const COMMUNITY_URL = 'https://gdg.community.dev/gdg-sydney/';
---

<SiteLayout
  title="DevFest Sydney | GDG Sydney"
  ogTitle="DevFest Sydney"
  description="DevFest Sydney is GDG Sydney's annual conference for developers and builders, presented by Google. See what happened at DevFest Sydney 2026 and hear first about 2027."
  ogImage={ogImage.src}
  ogImageAlt="Attendees at DevFest Sydney"
  current="devfest"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqStructuredData())} />

  <!-- ═════════════════════════════ HERO ═════════════════════════════════ -->
  <section class="hero" aria-labelledby="df-heading">
    <div class="hero-panel">
      <div class="hero-copy">
        <h1 class="hero-title" id="df-heading">DevFest<br />Sydney</h1>
        <p class="hero-lede">
          GDG Sydney's annual conference for developers and builders, presented by Google.
          One day, four rooms, all community-run.
        </p>
        <div class="hero-next">
          <p>DevFest Sydney 2027 hasn't been announced yet.</p>
          <div class="hero-actions">
            <a href={COMMUNITY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
              Join to hear first
            </a>
            <a href="/devfest/2026" class="hero-link">See DevFest 2026</a>
          </div>
        </div>
      </div>
    </div>
    <Image
      src={heroPhoto}
      alt="A full room watching a talk at DevFest Sydney"
      widths={[640, 1000, 1400]}
      sizes="(min-width: 900px) 50vw, 100vw"
      class="hero-photo"
      loading="eager"
    />
  </section>

  <section aria-label="The four DevFest rooms">
    <RoomBar />
  </section>

  <!-- ═════════════════════════════ 2026 ═════════════════════════════════ -->
  <section class="section" aria-labelledby="recap-heading">
    <div class="container recap">
      <div class="recap-copy">
        <h2 class="recap-title" id="recap-heading">
          2026 was<br />Build, Secure, Scale.
        </h2>
        <p>
          {speakers.length} speakers across four rooms at {EVENT.venue}, on {EVENT.dateLabel.replace('Saturday, ', 'Saturday ')}.
          The full schedule, every talk and the partners who made it possible are kept in the archive.
        </p>
        <a href="/devfest/2026" class="btn btn-dark btn-lg">Open the 2026 archive</a>
      </div>

      <ul class="lineup" role="list" aria-label="DevFest Sydney 2026 speakers">
        {lineup.map((speaker) => {
          const photo = speakerPhoto(speaker.slug);
          return (
            <li>
              <a
                href={`/devfest/2026/speakers/${speaker.slug}`}
                class="lineup-face"
                style={`--track-color: ${TRACKS[speaker.track].color}`}
                title={speaker.name}
              >
                {photo ? (
                  <Image src={photo} alt={speaker.name} width={120} height={120} />
                ) : (
                  <span aria-label={speaker.name}>{initials(speaker.name)}</span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════ GET INVOLVED ══════════════════════════ -->
  <section class="section involved" aria-labelledby="involved-heading">
    <div class="container">
      <h2 class="section-title" id="involved-heading">Help make 2027 happen</h2>
      <ul class="involved-list" role="list">
        <li class="involved-row">
          <h3>Speak</h3>
          <p>
            The Call for Speakers opens a few months before the event. Our monthly meetups are a
            good first stage, and first-time speakers are welcome.
          </p>
          <a href="/speak">Speak at a meetup</a>
        </li>
        <li class="involved-row">
          <h3>Sponsor</h3>
          <p>DevFest is run by volunteers, and sponsors make the day possible. Ask us for the prospectus.</p>
          <a href="mailto:hello@gdgsydney.com?subject=Sponsoring%20DevFest%20Sydney%202027">Email about sponsoring</a>
        </li>
        <li class="involved-row">
          <h3>Volunteer</h3>
          <p>Volunteers keep the day running and get to know the community behind it.</p>
          <a href="mailto:hello@gdgsydney.com?subject=Volunteering%20at%20DevFest%20Sydney">Email about volunteering</a>
        </li>
      </ul>
    </div>
  </section>
  <!-- ═══════════════════════════════ FAQ ════════════════════════════════ -->
  <section class="section faq" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <h2 class="section-title" id="faq-heading">Common questions</h2>
      <div class="faq-list">
        {DEVFEST_FAQ.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p set:html={item.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* ─── Hero: ink panel beside a full-height photo ────────────────────── */
  .hero {
    display: grid;
    background: var(--dark);
    color: white;
    padding-top: var(--header-h);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      min-height: min(88svh, 820px);
    }
  }

  .hero-panel {
    display: flex;
    align-items: center;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 5vw, 3rem);
  }

  /* Align the copy with the site's container edge on wide screens. */
  @media (min-width: 1260px) {
    .hero-panel { padding-left: calc((100vw - 1160px) / 2 + 3rem); }
  }

  .hero-copy { max-width: 34rem; }

  .hero-title {
    font-size: clamp(3.75rem, 10vw, 8.5rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.055em;
    margin-bottom: 2rem;
  }

  .hero-lede {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    max-width: 30em;
  }

  .hero-next {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .hero-next p { font-size: 0.95rem; color: rgba(255, 255, 255, 0.78); margin-bottom: 1.25rem; }

  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }

  .hero-link {
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 4px;
  }
  .hero-link:hover { text-decoration-color: white; }

  .hero-photo {
    width: 100%;
    height: 100%;
    min-height: 280px;
    max-height: 60svh;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 900px) {
    .hero-photo { max-height: none; }
  }

  /* ─── 2026 recap ────────────────────────────────────────────────────── */
  .recap { display: grid; gap: 3rem; align-items: center; }

  @media (min-width: 960px) {
    .recap { grid-template-columns: 1fr 1fr; gap: 5rem; }
  }

  .recap-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
    color: var(--dark);
    margin-bottom: 1.5rem;
  }

  .recap-copy p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #4a4a4a;
    max-width: 34em;
    margin-bottom: 2rem;
  }

  .btn-dark { background: var(--dark); color: white; }
  .btn-dark:hover { background: #000; }

  .lineup {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
    gap: 0.6rem;
  }

  .lineup-face {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #e6e4dd;
    border: 3px solid var(--track-color);
    font-weight: 700;
    color: var(--dark);
    text-decoration: none;
  }

  .lineup-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lineup-face:focus-visible,
  .involved-row a:focus-visible,
  .hero-link:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  /* ─── Get involved: rows, not cards ─────────────────────────────────── */
  .involved-list { list-style: none; border-top: 2px solid var(--dark); }

  .involved-row {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
  }

  @media (min-width: 800px) {
    .involved-row {
      grid-template-columns: 12rem 1fr auto;
      align-items: baseline;
    }
  }

  .involved-row h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--dark);
  }

  .involved-row p { font-size: 0.975rem; line-height: 1.65; color: #4a4a4a; max-width: 52ch; }

  .involved-row a {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--dark);
    text-decoration: underline;
    text-decoration-color: rgba(0, 0, 0, 0.3);
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .involved-row a:hover { text-decoration-color: var(--dark); }
  /* ─── FAQ: native disclosure rows ───────────────────────────────────── */
  .faq-list { border-top: 2px solid var(--dark); max-width: 860px; }

  .faq-item { border-bottom: 1px solid rgba(0, 0, 0, 0.14); }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.35rem;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--dark);
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }

  .faq-item summary:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }

  .faq-item p {
    padding-bottom: 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: #4a4a4a;
    max-width: 64ch;
  }

  .faq-item p :global(a) {
    color: var(--dark);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(0, 0, 0, 0.3);
    text-underline-offset: 3px;
  }
  .faq-item p :global(a:hover) { text-decoration-color: var(--dark); }
</style>
