---
import { Image, getImage } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { EVENT, STATS, speakers, speakerPhoto, initials } from '../../lib/devfest2026';
import heroPhoto from '../../assets/devfest/photos/hero.jpg';
import slide1 from '../../assets/devfest/photos/slide-1.jpg';
import slide3 from '../../assets/devfest/photos/slide-3.jpg';

const ogImage = await getImage({ src: heroPhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

// A handful of faces for the 2026 recap card, keynote first.
const featured = [...speakers].sort((a, b) => Number(b.track === 'keynote') - Number(a.track === 'keynote')).filter((s) => s.hasPhoto).slice(0, 7);
---

<SiteLayout
  title="DevFest Sydney | GDG Sydney"
  ogTitle="DevFest Sydney"
  description="DevFest Sydney is GDG Sydney's flagship annual conference for developers and builders, presented by Google. See what happened at DevFest Sydney 2026 and hear first about 2027."
  ogImage={ogImage.src}
  ogImageAlt="Attendees at DevFest Sydney"
  current="devfest"
>
  <!-- ═════════════════════════════ MASTHEAD ═════════════════════════════ -->
  <section class="df-hero" aria-labelledby="df-heading">
    <div class="container df-hero-inner">
      <div class="df-hero-text">
        <p class="eyebrow">GDG Sydney's flagship annual conference</p>
        <h1 class="df-heading" id="df-heading">DevFest<br />Sydney.</h1>
        <p class="df-lede">
          A full day of talks, workshops and demos for developers and builders.
          Run by the community, presented by Google.
        </p>
        <div class="df-actions">
          <a href="/devfest/2026" class="btn btn-primary btn-lg">See DevFest 2026</a>
          <a href="https://gdg.community.dev/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg">
            Hear about 2027 first
          </a>
        </div>
      </div>
      <div class="df-hero-photos" aria-hidden="true">
        <Image src={heroPhoto} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 40vw, 90vw" class="df-photo df-photo-main" loading="eager" />
        <Image src={slide1} alt="" widths={[320, 560]} sizes="(min-width: 900px) 18vw, 45vw" class="df-photo df-photo-side" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ NEXT EDITION ══════════════════════════ -->
  <section class="section" aria-labelledby="next-heading">
    <div class="container">
      <div class="next-card">
        <div class="next-accent" aria-hidden="true">
          <span style="background: var(--blue)"></span>
          <span style="background: var(--red)"></span>
          <span style="background: var(--yellow)"></span>
          <span style="background: var(--green)"></span>
        </div>
        <div class="next-body">
          <p class="eyebrow">Up next</p>
          <h2 class="section-title" id="next-heading">DevFest Sydney 2027</h2>
          <p class="next-text">
            The date, venue, Call for Speakers and tickets haven't been announced yet.
            Join GDG Sydney on our community platform and you'll hear as soon as they are.
          </p>
          <a href="https://gdg.community.dev/gdg-sydney/" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
            Join the community
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════ 2026 RECAP ══════════════════════════ -->
  <section class="section" aria-labelledby="recap-heading">
    <div class="container recap">
      <div class="recap-text">
        <p class="eyebrow">{EVENT.dateLabel}</p>
        <h2 class="section-title" id="recap-heading">DevFest Sydney 2026</h2>
        <p class="recap-theme">{EVENT.theme} <span>{EVENT.subtitle}.</span></p>
        <p class="recap-copy">
          We spent the day at {EVENT.venue}, with a main stage plus Developer, Builder and
          Workshops tracks running side by side. The schedule, every speaker and their talks are
          kept here.
        </p>

        <dl class="recap-stats">
          <div><dt>Speakers</dt><dd>{STATS.speakers}</dd></div>
          <div><dt>Sessions</dt><dd>{STATS.sessions}</dd></div>
          <div><dt>Tracks</dt><dd>{STATS.tracks}</dd></div>
        </dl>

        <div class="recap-links">
          <a href="/devfest/2026#schedule" class="text-link">Schedule →</a>
          <a href="/devfest/2026#speakers" class="text-link">Speakers →</a>
          <a href="/devfest/2026#partners" class="text-link">Partners →</a>
        </div>
      </div>

      <a href="/devfest/2026#speakers" class="recap-faces" aria-label="See all DevFest Sydney 2026 speakers">
        {featured.map((speaker) => {
          const photo = speakerPhoto(speaker.slug);
          return photo ? (
            <Image src={photo} alt="" width={96} height={96} class="face" />
          ) : (
            <span class="face face-initials">{initials(speaker.name)}</span>
          );
        })}
        <span class="face face-more">+{speakers.length - featured.length}</span>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════ GET INVOLVED ══════════════════════════ -->
  <section class="section" aria-labelledby="involved-heading">
    <div class="container">
      <h2 class="section-title" id="involved-heading">Get involved</h2>
      <div class="involved-grid">
        <article class="involved-card" style="--track-color: var(--red)">
          <span class="track-tag">Speak</span>
          <h3>Give a talk</h3>
          <p>
            The DevFest Call for Speakers opens a few months before the event. Speaking at one of
            our monthly meetups first is a great way to start, and first-time speakers are welcome.
          </p>
          <a href="/speak" class="text-link">Speak at a meetup →</a>
        </article>
        <article class="involved-card" style="--track-color: var(--blue)">
          <span class="track-tag">Sponsor</span>
          <h3>Support the day</h3>
          <p>
            DevFest is run by volunteers, and sponsors make the day possible. Get in touch and
            we'll send you the prospectus.
          </p>
          <a href="mailto:hello@gdgsydney.com?subject=Sponsoring%20DevFest%20Sydney%202027" class="text-link">
            Ask about sponsoring →
          </a>
        </article>
        <article class="involved-card" style="--track-color: var(--green)">
          <span class="track-tag">Volunteer</span>
          <h3>Join the crew</h3>
          <p>
            Volunteers keep the day running and get to know the community behind it. We're always
            looking for more hands.
          </p>
          <a href="mailto:hello@gdgsydney.com?subject=Volunteering%20at%20DevFest%20Sydney" class="text-link">
            Put your hand up →
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="df-photo-band" aria-hidden="true">
    <Image src={slide3} alt="" widths={[800, 1400, 2000]} sizes="100vw" class="band-img" />
  </section>
</SiteLayout>

<style>
  /* ─── Masthead ──────────────────────────────────────────────────────── */
  .df-hero {
    padding-top: calc(var(--header-h) + clamp(3rem, 7vw, 5.5rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .df-hero-inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .df-hero-inner { grid-template-columns: 1.05fr 1fr; gap: 4rem; }
  }

  .df-heading {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--dark);
    margin: 0.75rem 0 1.5rem;
  }

  .df-lede {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.72;
    color: var(--muted);
    max-width: 460px;
    margin-bottom: 2.25rem;
  }

  .df-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .df-hero-photos { position: relative; padding-bottom: 12%; }

  .df-photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.35);
  }

  .df-photo-main { aspect-ratio: 3 / 2; rotate: 2deg; }

  .df-photo-side {
    position: absolute;
    width: 46%;
    aspect-ratio: 4 / 3;
    left: -6%;
    bottom: 0;
    rotate: -4deg;
    border: 4px solid #fff;
  }

  /* ─── Next edition ──────────────────────────────────────────────────── */
  .next-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
  }

  .next-accent { display: flex; height: 4px; }
  .next-accent span { flex: 1; }

  .next-body { padding: clamp(2rem, 5vw, 3.5rem); }
  .next-body .section-title { margin: 0.5rem 0 1rem; }

  .next-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 58ch;
    margin-bottom: 2rem;
  }

  /* ─── 2026 recap ────────────────────────────────────────────────────── */
  .recap { display: grid; gap: 3rem; align-items: center; }

  @media (min-width: 900px) {
    .recap { grid-template-columns: 1.4fr 1fr; gap: 5rem; }
  }

  .recap .section-title { margin: 0.5rem 0 1rem; }

  .recap-theme {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--dark);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .recap-theme span { font-weight: 400; color: var(--muted); }

  .recap-copy {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--muted);
    max-width: 58ch;
  }

  .recap-stats {
    display: flex;
    gap: 2.5rem;
    margin: 2rem 0;
  }

  .recap-stats div { display: flex; flex-direction: column-reverse; gap: 0.25rem; }

  .recap-stats dd {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--dark);
    line-height: 1;
  }

  .recap-stats dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .recap-links { display: flex; flex-wrap: wrap; gap: 1.5rem; }

  .text-link {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--blue);
    text-decoration: none;
  }
  .text-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .recap-faces {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    max-width: 400px;
    text-decoration: none;
  }

  .face {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #e8e6e0;
    object-fit: cover;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--dark);
    transition: transform 0.2s ease;
  }
  .recap-faces:hover .face { transform: translateY(-2px); }

  .face-more {
    background: var(--dark);
    color: white;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  /* ─── Get involved ──────────────────────────────────────────────────── */
  .involved-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 800px) {
    .involved-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .involved-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-top: 3px solid var(--track-color);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .involved-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--dark);
  }

  .involved-card p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--muted);
    flex: 1;
  }

  /* ─── Photo band ────────────────────────────────────────────────────── */
  .df-photo-band { line-height: 0; }

  .band-img {
    width: 100%;
    height: clamp(220px, 32vw, 420px);
    object-fit: cover;
    object-position: center 40%;
  }
</style>
