---
// Shared shell for every page: head/meta, header, footer, and the base styles and colour
// tokens. The site is dark only; change the palette here, not in individual pages.
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { hasDarkLogo, logoSrc } from '../lib/logo';

interface Props {
  title: string;
  description: string;
  // Social cards; defaults to the meta description.
  ogDescription?: string;
  ogTitle?: string;
  ogImage?: string;
  ogImageAlt?: string;
  current?: 'speak' | 'devfest';
}

const {
  title,
  description,
  ogDescription = description,
  ogTitle = title,
  ogImage = '/logo.png',
  ogImageAlt = 'GDG Sydney logo',
  current,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const isLargeImage = ogImage !== '/logo.png';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#1e1e1e" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="GDG Sydney" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content="en_AU" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content={isLargeImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <slot name="head" />
</head>
<body>

  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo" aria-label="GDG Sydney home">
        <img src={logoSrc} alt="Google Developer Group Sydney" class:list={['logo-img', { 'logo-chip': !hasDarkLogo }]} />
      </a>
      <nav class="header-nav" aria-label="Main navigation">
        <a href="/#events" class="nav-link">Events</a>
        <a href="/speak" class="nav-link" aria-current={current === 'speak' ? 'page' : undefined}>Speak</a>
        <a href="/devfest" class="nav-link" aria-current={current === 'devfest' ? 'page' : undefined}>DevFest</a>
        <a
          href="https://gdg.community.dev/gdg-sydney/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm"
        >
          Join GDG Sydney
        </a>
      </nav>
    </div>
  </header>
  <script>
    // The header stays see-through over the page hero and only fills in once the hero has
    // almost scrolled away (its bottom reaches the header). Pages without a hero
    // (marked data-hero) fill in as soon as you scroll.
    const header = document.querySelector<HTMLElement>('.header');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (header) {
      const update = () => {
        const overHero = hero
          ? hero.getBoundingClientRect().bottom > header.offsetHeight
          : window.scrollY < 8;
        header.classList.toggle('is-at-top', overHero);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>

  <main id="main-content">
    <slot />
  </main>

  <Footer />

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; color-scheme: dark; }

  :root {
    --blue:   #4285F4;
    --green:  #34A853;
    --yellow: #f9ab00;
    --red:    #EA4335;

    /* Dark theme. Black 02 (#1e1e1e) from the brand palette is the page itself. */
    --bg:         #1e1e1e;
    --ink:        #141414;   /* deep bands, darker than the page */
    --surface:    #272727;   /* cards and inputs */
    --surface-2:  #303030;   /* raised, hover, image wells */
    --fg:         #f0f0f0;   /* Off White: headings and strong text */
    --text:       #d6d6d4;
    --text-soft:  #b4b4b0;
    --muted:      #9aa0a6;
    --border:     rgba(255, 255, 255, 0.1);
    --on-accent:  #1e1e1e;   /* text on solid brand colours */

    /* Text-safe tints of the core colours (Google's dark-theme 300 tones). The core
       colours stay for fills, borders and buttons; these are for coloured text. */
    --blue-text:   #8ab4f8;
    --red-text:    #f28b82;
    --green-text:  #81c995;
    --yellow-text: #fdd663;

    --sans: 'Google Sans', 'Google Sans Text', system-ui, -apple-system, sans-serif;
    --mono: 'Google Sans Mono', 'Roboto Mono', monospace;

    --header-h: 80px;
    /* Every page hero uses this height, so they match across the site. */
    --hero-h: min(75svh, 740px);
    --radius-card: 16px;
  }

  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  [id] { scroll-margin-top: calc(var(--header-h) + 1rem); }

  .container {
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  /* ─── Header ────────────────────────────────────────────────────────── */
  .header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    height: var(--header-h);
    background: rgba(30, 30, 30, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    display: flex;
    align-items: center;
    transition: background-color 0.25s ease, border-color 0.25s ease, backdrop-filter 0.25s ease;
  }

  /* Over the page hero the header is see-through; it gains its background once the hero
     has scrolled away. Set by the script below, so without JS the header stays solid. */
  .header.is-at-top {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .logo { display: flex; align-items: center; text-decoration: none; }
  .logo-img { height: 48px; width: auto; display: block; flex-shrink: 0; }

  /* Fallback until public/gdg-logo-dark.png exists: the light-background logo on a light
     chip, since the brand guide doesn't allow recolouring it. See src/lib/logo.ts. */
  .logo-chip {
    background: var(--fg);
    border-radius: 10px;
    padding: 4px 10px;
    box-sizing: content-box;
  }

  .header-nav { display: flex; align-items: center; gap: 1.75rem; }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] { color: var(--fg); }

  @media (max-width: 700px) {
    :root { --hero-h: min(68svh, 580px); }
  }

  @media (max-width: 640px) {
    .header-nav .nav-link { display: none; }
    .logo-img { height: 34px; }
    .header-nav .btn-sm { padding: 0.55em 1.1em; font-size: 0.8rem; }
  }

  /* ─── Buttons ───────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    border-radius: 100px;
    font-family: var(--sans);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
    border: none;
    line-height: 1;
  }
  .btn:hover  { transform: translateY(-1px); }
  .btn:active { transform: translateY(0); }
  .btn-sm { padding: 0.6em 1.4em;  font-size: 0.825rem; }
  .btn-lg { padding: 0.78em 1.8em; font-size: 1rem; }

  .btn-primary {
    background: var(--blue);
    color: white;
    box-shadow: 0 1px 6px rgba(66, 133, 244, 0.28);
  }
  .btn-primary:hover { box-shadow: 0 4px 18px rgba(66, 133, 244, 0.42); }

  .btn-ghost {
    background: transparent;
    color: var(--fg);
    border: 1.5px solid rgba(255, 255, 255, 0.2);
  }
  .btn-ghost:hover { border-color: var(--fg); background: rgba(255, 255, 255, 0.04); }

  /* ─── Sections ──────────────────────────────────────────────────────── */
  .section { padding-block: clamp(4rem, 7vw, 6rem); }
  .section + .section { border-top: 1px solid var(--border); }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--fg);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* Track dot + dark label: core blue, red and yellow fail AA as small text on --bg. */
  .track-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--fg);
  }
  .track-tag::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--track-color, var(--muted));
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    html { scroll-behavior: auto; }
  }
</style>
