---
// The four DevFest rooms as solid colour blocks. Colour = room = track, everywhere on the
// DevFest pages. Dark text throughout: white fails contrast on the yellow and green.
import { ROOM_LABELS, ROOM_TRACKS } from '../../lib/devfest2026';

interface Props {
  // 'full' shows the track description; 'compact' is the schedule's column header.
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;
---

<ul class:list={['room-bar', `room-bar--${variant}`]} role="list">
  {ROOM_TRACKS.map((r) => (
    <li class="room" style={`--room: ${r.color}`}>
      <span class="room-name">{r.name}</span>
      <span class="room-where">{ROOM_LABELS[r.room].name}</span>
      {variant === 'full' && <span class="room-text">{r.text}</span>}
    </li>
  ))}
</ul>

<style>
  .room-bar {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 900px) {
    .room-bar { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .room {
    background: var(--room);
    color: var(--on-accent);
    display: flex;
    flex-direction: column;
  }

  .room-bar--full .room {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    gap: 0.35rem;
  }

  .room-name {
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .room-where {
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .room-text {
    padding-top: 1.25rem;
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 30ch;
  }

  /* Compact: the schedule header. Always four across, matching the grid columns. */
  .room-bar--compact { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }

  .room-bar--compact .room {
    padding: 0.7rem 0.9rem;
    border-radius: 8px;
    gap: 0.1rem;
  }

  .room-bar--compact .room-name { font-size: 1rem; letter-spacing: -0.015em; }
  .room-bar--compact .room-where { font-size: 0.7rem; }
</style>
